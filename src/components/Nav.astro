---
import { getDict, otherLang, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang);
const alt = getDict(otherLang(lang));
const links = [
  ['#uslugi', t.nav.services],
  ['#proces', t.nav.process],
  ['#o-mnie', t.nav.about],
  ['#faq', t.nav.faq],
] as const;
---

<header class="nav" data-nav>
  <div class="wrap">
    <div class="bar">
      <a class="logo" href={t.path} aria-label="Maciej Zięciak — home">Maciej Zięciak<span>.</span></a>

      <nav class="links" aria-label="Main">
        {links.map(([href, label]) => <a href={href}>{label}</a>)}
      </nav>

      <div class="end">
        <a class="lang" href={alt.path} hreflang={alt.lang} aria-label={t.nav.switchLabel}>
          <span class:list={{ on: lang === 'pl' }}>PL</span>
          <span class:list={{ on: lang === 'en' }}>EN</span>
        </a>
        <a class="btn btn--lime cta" href="#kontakt">{t.nav.cta} <span class="arrow" aria-hidden="true">→</span></a>
        <button class="burger" type="button" aria-expanded="false" aria-controls="mobile-menu" data-burger>
          <span class="sr-only" data-burger-label data-open={t.nav.menu} data-close={t.nav.close}>{t.nav.menu}</span>
          <i></i><i></i>
        </button>
      </div>
    </div>
  </div>

  <div class="sheet" id="mobile-menu" data-sheet hidden>
    <nav class="wrap sheet__in" aria-label="Mobile">
      {[...links, ['#kontakt', t.nav.contact]].map(([href, label]) => <a href={href}>{label}</a>)}
      <a class="btn btn--lime" href={alt.path} hreflang={alt.lang}>{t.nav.switchLabel} →</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding-top: 14px;
    pointer-events: none;
  }
  .bar {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 68px;
    padding: 0 6px 0 4px;
    border-radius: var(--r);
    color: var(--cream);
    transition:
      background-color 0.4s var(--ease),
      padding 0.4s var(--ease),
      box-shadow 0.4s var(--ease);
  }
  .nav.is-scrolled .bar {
    padding: 0 10px 0 22px;
    background: rgb(15 43 35 / 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 12px 40px -12px rgb(10 31 25 / 0.45);
  }
  .logo {
    font-size: 1.375rem;
    font-weight: 760;
    letter-spacing: -0.035em;
    white-space: nowrap;
  }
  .logo span {
    color: var(--lime);
  }
  .links {
    display: flex;
    gap: 6px;
    font-size: 1rem;
    font-weight: 520;
  }
  .links a {
    padding: 9px 14px;
    border-radius: 999px;
    transition: background-color 0.25s, color 0.25s;
  }
  .links a:hover {
    background: rgb(244 239 227 / 0.12);
  }
  .end {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .lang {
    display: inline-flex;
    padding: 4px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1.5px rgb(244 239 227 / 0.35);
    font-size: 0.8125rem;
    font-weight: 650;
  }
  .lang span {
    padding: 6px 10px;
    border-radius: 999px;
    opacity: 0.7;
  }
  .lang .on {
    background: var(--cream);
    color: var(--forest);
    opacity: 1;
  }
  .cta {
    padding: 13px 20px;
    font-size: 1rem;
    border-radius: 14px;
  }
  .burger {
    display: none;
    position: relative;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: var(--lime);
  }
  .burger i {
    position: absolute;
    left: 14px;
    right: 14px;
    height: 2.5px;
    border-radius: 2px;
    background: var(--forest);
    transition: transform 0.4s var(--spring);
  }
  .burger i:first-of-type { top: 19px; }
  .burger i:last-of-type { top: 27px; }
  .burger[aria-expanded='true'] i:first-of-type { transform: translateY(4px) rotate(45deg); }
  .burger[aria-expanded='true'] i:last-of-type { transform: translateY(-4px) rotate(-45deg); }

  .nav:has([aria-expanded='true']) .bar {
    background: var(--forest);
  }
  .sheet {
    pointer-events: auto;
    position: fixed;
    inset: 0;
    z-index: -1;
    background: var(--forest);
    color: var(--cream);
    overflow: auto;
  }
  .sheet__in {
    display: grid;
    gap: 4px;
    padding-top: 120px;
    padding-bottom: 48px;
  }
  .sheet__in a:not(.btn) {
    font-size: clamp(2.75rem, 13vw, 4.5rem);
    font-weight: 780;
    letter-spacing: -0.045em;
    line-height: 1.1;
  }
  .sheet__in .btn {
    justify-self: start;
    margin-top: 28px;
  }

  @media (max-width: 1060px) {
    .links { display: none; }
  }
  @media (max-width: 720px) {
    .cta, .end > .lang { display: none; }
    .burger { display: block; }
    .bar { height: 60px; }
  }
</style>
