---
import { getDict, type Lang } from '../i18n';
interface Props { lang: Lang }
const t = getDict(Astro.props.lang);
const h = t.hero;
---

<section class="hero" id="top">
  <div class="wrap top">
    <p class="eyebrow">{h.pill}</p>
    <h1>
      <span>{h.titleA}</span>
      <span class="ai">{h.titleB}</span>
    </h1>
    <p class="lead">{h.lead}</p>
    <div class="ctas">
      <a class="btn" href="#kontakt">{h.ctaPrimary}</a>
      <a class="more" href="#doswiadczenie">{h.ctaSecondary}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(132px, 15vw, 200px);
    padding-bottom: clamp(96px, 12vw, 168px);
  }
  .top {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 22px;
  }
  h1 {
    display: grid;
    font-size: clamp(3rem, 1.2rem + 6.6vw, 6.5rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
    font-weight: 700;
  }
  h1 .ai {
    padding-bottom: 0.08em;
  }
  .top .lead {
    max-width: 38ch;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 16px 32px;
    margin-top: 14px;
  }
  .js .top > * {
    animation: up 1.4s var(--ease-out) both;
  }
  .js .top > :nth-child(2) { animation-delay: 0.1s; }
  .js .top > :nth-child(3) { animation-delay: 0.25s; }
  .js .top > :nth-child(4) { animation-delay: 0.35s; }
  @keyframes up {
    from { opacity: 0; transform: translateY(30px); }
  }
  @media (max-width: 520px) {
    .ctas .btn { width: 100%; }
  }
</style>
