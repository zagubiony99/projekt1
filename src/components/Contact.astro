---
import { site } from '../config';
import { getDict, type Lang } from '../i18n';
interface Props { lang: Lang }
const t = getDict(Astro.props.lang);
const c = t.contact;
---

<section class="section section--black contact" id="kontakt" data-dark aria-labelledby="kontakt-h">
  <div class="aura" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="wrap">
    <header class="head">
      <h2 class="h2 ai" id="kontakt-h" data-reveal>{c.title}</h2>
      <p class="lead" data-reveal style="--d:1">{c.lead}</p>
    </header>

    <form
      class="form"
      action={`mailto:${site.email}`}
      method="get"
      data-form
      data-reveal
      data-email={site.email}
      data-subject={c.subject}
      data-l-topics={c.bodyTopics}
      data-l-url={c.bodyUrl}
    >
      <input type="hidden" name="subject" value={c.subject} />
      <fieldset>
        <legend>{c.topicsLabel}</legend>
        <div class="chips">
          {c.topics.map((tp) => (
            <label class="chip">
              <input type="checkbox" name="topic" value={tp} />
              <span>{tp}</span>
            </label>
          ))}
        </div>
      </fieldset>
      <label class="field">
        <span>{c.urlLabel}</span>
        <input type="url" name="url" placeholder={c.urlPlaceholder} autocomplete="url" inputmode="url" />
      </label>
      <label class="field">
        <span>{c.msgLabel}</span>
        <textarea name="body" rows="4" placeholder={c.msgPlaceholder} required></textarea>
      </label>
      <div class="actions">
        <button class="btn" type="submit" data-magnet>{c.submit}</button>
        <p class="direct">
          {c.orEmail}: <a class="more" href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </div>
    </form>
  </div>
</section>

<style>
  .contact {
    position: relative;
    overflow: hidden;
  }
  .contact > .wrap {
    position: relative;
  }
  .aura {
    position: absolute;
    inset: 0;
    filter: blur(80px);
    opacity: 0.55;
    pointer-events: none;
  }
  .aura i {
    position: absolute;
    width: 46vw;
    max-width: 640px;
    aspect-ratio: 1;
    border-radius: 50%;
    animation: drift 18s ease-in-out infinite alternate;
  }
  .aura i:nth-child(1) { left: 5%; top: 40%; background: rgb(8 148 255 / 0.45); }
  .aura i:nth-child(2) { right: 8%; top: 25%; background: rgb(201 89 221 / 0.4); animation-duration: 22s; animation-delay: -6s; }
  .aura i:nth-child(3) { left: 35%; bottom: -20%; background: rgb(255 46 84 / 0.3); animation-duration: 26s; animation-delay: -12s; }
  @keyframes drift {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(8vw, -6vh) scale(1.15); }
    100% { transform: translate(-6vw, 4vh) scale(0.9); }
  }
  .contact .h2 {
    font-size: clamp(2.75rem, 1.6rem + 4.6vw, 5.5rem);
    padding-bottom: 0.06em;
    background-size: 250% 100%;
    animation: flow 10s ease-in-out infinite;
  }
  @keyframes flow {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }
  .form {
    transition: box-shadow 0.6s var(--ease-out);
  }
  .form:focus-within {
    box-shadow: 0 0 0 1px rgb(41 151 255 / 0.4), 0 30px 80px -30px rgb(41 151 255 / 0.35);
  }
  .form {
    max-width: 720px;
    margin-inline: auto;
    display: grid;
    gap: 24px;
    padding: clamp(24px, 4vw, 48px);
    border-radius: var(--r-lg);
    background: rgb(22 22 23 / 0.7);
    backdrop-filter: blur(20px) saturate(1.4);
    -webkit-backdrop-filter: blur(20px) saturate(1.4);
    border: 1px solid rgb(255 255 255 / 0.08);
  }
  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
  }
  legend,
  .field > span {
    display: block;
    margin-bottom: 10px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: #f5f5f7;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .chip span {
    display: inline-block;
    padding: 8px 15px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--dark-line);
    color: #d2d2d7;
    font-size: 0.9375rem;
    cursor: pointer;
    user-select: none;
    transition: background-color 0.2s, color 0.2s, box-shadow 0.2s;
  }
  .chip:hover span {
    box-shadow: inset 0 0 0 1px var(--dark-muted);
  }
  .chip input:checked + span {
    background: #f5f5f7;
    color: var(--ink);
    box-shadow: none;
  }
  .chip input:focus-visible + span {
    outline: 2px solid var(--link-dark);
    outline-offset: 2px;
  }
  .field input,
  .field textarea {
    width: 100%;
    padding: 14px 16px;
    border-radius: 12px;
    border: 1px solid var(--dark-line);
    background: var(--black);
    color: #f5f5f7;
    font-size: 1.0625rem;
    resize: vertical;
    transition: border-color 0.2s;
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--dark-muted);
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--link-dark);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
  }
  .direct {
    color: var(--dark-muted);
    font-size: 0.9375rem;
  }
  .direct .more {
    font-size: 0.9375rem;
  }
  .direct .more::after {
    content: none;
  }
</style>
