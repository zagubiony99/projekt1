---
import { getDict, type Lang } from '../i18n';
interface Props { lang: Lang }
const t = getDict(Astro.props.lang);
const p = t.process;
---

<section class="section" id="proces" aria-labelledby="proces-h">
  <div class="wrap">
    <header class="head">
      <p class="eyebrow">{p.label}</p>
      <h2 class="h2" id="proces-h" data-reveal>{p.title}</h2>
    </header>
    <ol class="steps">
      {p.steps.map((s, i) => (
        <li class="step" data-reveal style={`--d:${i}`}>
          <span class="bar" aria-hidden="true"><i style={`--w:${(i + 1) * 25}%`}></i></span>
          <h3>{s.name}</h3>
          <p>{s.desc}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(20px, 2.4vw, 36px);
  }
  .bar {
    display: block;
    height: 2px;
    border-radius: 2px;
    background: var(--line-2);
    margin-bottom: 22px;
    overflow: hidden;
  }
  .bar i {
    display: block;
    width: var(--w);
    height: 100%;
    background: var(--accent);
  }
  h3 {
    font-size: 1.25rem;
    font-weight: 560;
    letter-spacing: -0.03em;
  }
  p {
    margin-top: 8px;
    color: var(--muted);
    font-size: 0.9375rem;
  }
  @media (max-width: 900px) {
    .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 40px; }
  }
  @media (max-width: 520px) {
    .steps { grid-template-columns: 1fr; }
  }
</style>
