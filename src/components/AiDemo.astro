---
import { getDict, type Lang } from '../i18n';
interface Props { lang: Lang }
const t = getDict(Astro.props.lang);
const d = t.hero.demo;

// One timeline (ms from the moment the window scrolls into view). Every element gets its
// own delay at build time, so the browser plays the whole scene from CSS alone.
const Q_START = 250;
const Q_CHAR = 24;
const qChars = [...d.q].map((c, i) => ({ c, t: Q_START + i * Q_CHAR }));
const Q_END = Q_START + qChars.length * Q_CHAR;
const THINK = Q_END + 250;
const A_START = THINK + 1250;
const A_WORD = 42;

// Answer: words, punctuation and [n] citations
type Tok = { kind: 'w' | 'p' | 'c'; v: string; t: number; you?: boolean };
const toks: Tok[] = [];
let k = 0;
for (const m of d.answer.matchAll(/\[(\d+)\]|[^ \t\n[]+/g)) {
  if (m[1]) {
    const n = Number(m[1]);
    toks.push({ kind: 'c', v: m[1], t: A_START + k * A_WORD, you: !!d.sources[n - 1]?.you });
  } else {
    // a word may carry trailing punctuation after a citation, e.g. "[2]." -> "."
    toks.push({ kind: /^[.,;:!?…]+$/.test(m[0]) ? 'p' : 'w', v: m[0], t: A_START + k * A_WORD });
    k++;
  }
}
const A_END = A_START + k * A_WORD;
const SRC = A_END + 150;
const HL = SRC + d.sources.length * 140 + 350;
---

<figure class="demo" data-demo aria-label={`${d.app}: ${d.note}`}>
  <div class="chrome" aria-hidden="true">
    <i></i><i></i><i></i>
    <span class="app"><span class="spark"></span>{d.app}</span>
    <span class="note">{d.note}</span>
  </div>

  <div class="body">
    <p class="q">
      <span class="sr-only">{d.q}</span>
      <span aria-hidden="true">{qChars.map((x) => <span class="qc" style={`--t:${x.t}ms`}>{x.c}</span>)}<span class="caret" style={`--t:${Q_END + 400}ms`}></span></span>
    </p>

    <div class="answer">
      <span class="think" aria-hidden="true" style={`--t:${THINK}ms`}>{d.think}</span>
      <p class="a">
        {toks.map((x) =>
          x.kind === 'c' ? (
            <sup class:list={['cite', { you: x.you }]} style={`--t:${x.t}ms;--hl:${HL}ms`}>{x.v}</sup>
          ) : x.kind === 'p' ? (
            <span class="aw" style={`--t:${x.t}ms`}>{x.v}</span>
          ) : (
            <>{' '}<span class="aw" style={`--t:${x.t}ms`}>{x.v}</span></>
          ),
        )}
      </p>
    </div>

    <p class="srcl" style={`--t:${SRC}ms`}>{d.sourcesLabel}</p>
    <ol class="srcs">
      {d.sources.map((s, i) => (
        <li class:list={['src', { you: s.you }]} style={`--t:${SRC + i * 140}ms;--hl:${HL}ms`}>
          <span class="fav" aria-hidden="true">{s.d[0].toUpperCase()}</span>
          <span class="n" aria-hidden="true">{i + 1}</span>
          <b>{s.d}</b>
          <span class="tt">{s.t}</span>
          {s.you && <span class="badge" style={`--hl:${HL}ms`}>{d.you}</span>}
        </li>
      ))}
    </ol>
  </div>
</figure>

<style>
  .demo {
    position: relative;
    width: min(100%, 860px);
    margin: clamp(48px, 7vh, 80px) auto 0;
    border-radius: 24px;
    background: rgb(255 255 255 / 0.9);
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.06),
      0 50px 100px -40px rgb(40 30 90 / 0.35),
      0 30px 60px -30px rgb(0 0 0 / 0.18);
    text-align: left;
    /* rises and settles as the hero scrolls away (--h is set by the scroll loop in main.ts) */
    transform: translateY(calc((1 - var(--h, 0)) * 40px)) scale(calc(0.94 + var(--h, 0) * 0.06));
    transform-origin: 50% 0;
    will-change: transform;
  }
  :global(.sv-hero) .demo,
  :global(html:not(.js)) .demo {
    transform: none;
    will-change: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .demo { transform: none; }
  }
  .chrome {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--line);
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .chrome i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #e3e3e8;
  }
  .app {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-left: 10px;
    color: var(--ink);
    font-weight: 600;
  }
  .spark {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: conic-gradient(from 200deg, var(--a1), var(--a2), var(--a3), var(--a4), var(--a1));
  }
  .note {
    margin-left: auto;
  }
  .body {
    display: grid;
    gap: 18px;
    padding: clamp(20px, 3.4vw, 36px);
  }
  .q {
    justify-self: end;
    max-width: 85%;
    padding: 12px 18px;
    border-radius: 20px 20px 6px 20px;
    background: var(--gray);
    font-size: clamp(0.9375rem, 0.9rem + 0.25vw, 1.0625rem);
    font-weight: 500;
  }
  .caret {
    display: inline-block;
    width: 2px;
    height: 1.1em;
    margin-left: 2px;
    vertical-align: -0.18em;
    background: var(--link);
  }
  .answer {
    position: relative;
  }
  .think {
    position: absolute;
    top: 0;
    left: 0;
    font-size: 0.9375rem;
    font-weight: 500;
    color: transparent;
    background: linear-gradient(90deg, #86868b 0%, #86868b 40%, #1d1d1f 50%, #86868b 60%, #86868b 100%) 0 0 / 250% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    opacity: 0;
  }
  .aw {
    display: inline-block;
  }
  .a {
    font-size: clamp(1rem, 0.95rem + 0.35vw, 1.25rem);
    line-height: 1.55;
    letter-spacing: -0.012em;
    color: var(--ink);
  }
  .cite {
    display: inline-grid;
    place-items: center;
    min-width: 1.45em;
    height: 1.45em;
    margin-left: 3px;
    padding: 0 0.35em;
    border-radius: 999px;
    background: var(--gray-2);
    color: var(--ink-2);
    font-size: 0.62em;
    font-weight: 650;
    vertical-align: 0.45em;
    line-height: 1;
  }
  .cite.you {
    transition: background-color 0.5s, color 0.5s, box-shadow 0.5s;
  }
  .srcl {
    margin-top: 4px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--muted);
  }
  .srcs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin-top: -8px;
  }
  .src {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 4px 10px;
    padding: 14px;
    border-radius: 16px;
    background: var(--gray);
    font-size: 0.8125rem;
    line-height: 1.3;
  }
  .fav {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 9px;
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--line);
    font-weight: 700;
    color: var(--ink-2);
  }
  .src .n {
    position: absolute;
    top: 10px;
    right: 12px;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 600;
  }
  .src b {
    font-weight: 650;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding-right: 14px;
  }
  .tt {
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* "your site": gradient ring, lifted, with a badge */
  .src.you::before {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 18px;
    padding: 2px;
    background: linear-gradient(120deg, var(--a1), var(--a2), var(--a3), var(--a4));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
  }
  .badge {
    position: absolute;
    left: 50%;
    top: 0;
    translate: -50% -55%;
    padding: 4px 10px;
    border-radius: 999px;
    background: linear-gradient(120deg, var(--a1), var(--a2), var(--a3));
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 650;
    white-space: nowrap;
    box-shadow: 0 8px 20px -8px color-mix(in srgb, var(--a2) 70%, transparent);
  }

  /* Final state is the default (no JS, reduced motion). With JS the scene starts empty
     and plays once when the window scrolls into view (.play). */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .demo:not(.play) :is(.qc, .aw, .cite, .srcl, .src, .badge) {
      opacity: 0;
    }
    :global(.js) .demo:not(.play) .caret {
      opacity: 0;
    }
    :global(.js) .demo.play .qc {
      opacity: 0;
      animation: show 0.01s linear var(--t) forwards;
    }
    :global(.js) .demo.play .caret {
      animation: blink 0.9s steps(1) infinite, hide 0.01s linear var(--t) forwards;
    }
    :global(.js) .demo.play .think {
      animation: think 1.2s ease var(--t) both, sweep 1.2s linear var(--t);
    }
    :global(.js) .demo.play .aw {
      opacity: 0;
      animation: word 0.5s var(--ease-out) var(--t) forwards;
    }
    :global(.js) .demo.play .cite {
      opacity: 0;
      animation: pop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) var(--t) forwards;
    }
    :global(.js) .demo.play :is(.srcl, .src) {
      opacity: 0;
      animation: word 0.6s var(--ease-out) var(--t) forwards;
    }
    :global(.js) .demo.play .badge {
      opacity: 0;
      animation: badge 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) var(--hl) forwards;
    }
    :global(.js) .demo.play .src.you::before {
      animation: show 0.6s ease var(--hl) forwards;
    }
    :global(.js) .demo.play .src.you {
      animation: word 0.6s var(--ease-out) var(--t) forwards, lift 0.7s var(--ease-out) var(--hl) forwards;
    }
    :global(.js) .demo.play .cite.you {
      animation: pop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) var(--t) forwards, mark 0.6s ease var(--hl) forwards;
    }
  }
  /* without the timeline (reduced motion / no JS) show the highlighted end state */
  @media (prefers-reduced-motion: reduce) {
    .src.you::before { opacity: 1; }
    .cite.you { background: linear-gradient(120deg, var(--a1), var(--a2)); color: #fff; }
    .caret { display: none; }
  }
  :global(html:not(.js)) .src.you::before { opacity: 1; }
  :global(html:not(.js)) .cite.you { background: linear-gradient(120deg, var(--a1), var(--a2)); color: #fff; }
  :global(html:not(.js)) .caret { display: none; }

  @keyframes show { to { opacity: 1; } }
  @keyframes hide { to { opacity: 0; } }
  @keyframes blink { 50% { background: transparent; } }
  @keyframes think {
    0% { opacity: 0; }
    15%, 75% { opacity: 1; }
    100% { opacity: 0; }
  }
  @keyframes sweep { from { background-position: 100% 0; } to { background-position: 0 0; } }
  @keyframes word {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes pop {
    from { opacity: 0; transform: scale(0.4); }
    to { opacity: 1; transform: none; }
  }
  @keyframes badge {
    from { opacity: 0; transform: translateY(6px) scale(0.8); }
    to { opacity: 1; transform: none; }
  }
  @keyframes lift {
    to { transform: translateY(-4px); background: #fff; box-shadow: 0 18px 40px -18px color-mix(in srgb, var(--a2) 55%, transparent); }
  }
  @keyframes mark {
    to { background: linear-gradient(120deg, var(--a1), var(--a2)); color: #fff; box-shadow: 0 4px 12px -4px color-mix(in srgb, var(--a1) 60%, transparent); }
  }

  @media (max-width: 640px) {
    .demo { border-radius: 20px; }
    .chrome i { display: none; }
    .app { margin-left: 0; }
    .q { max-width: 95%; }
    .srcs { grid-template-columns: 1fr; gap: 8px; margin-top: -6px; }
    .src { padding: 10px 12px; }
    .src .tt { -webkit-line-clamp: 1; }
    .badge { left: auto; right: 36px; translate: 0 -55%; }
  }
</style>
