---
import { getDict, otherLang, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang);
const alt = getDict(otherLang(lang));
const links = [
  ['#uslugi', t.nav.services],
  ['#doswiadczenie', t.nav.experience],
  ['#proces', t.nav.process],
  ['#faq', t.nav.faq],
] as const;
---

<header class="nav" data-nav>
  <div class="wrap bar">
    <a class="logo" href={t.path} aria-label="Maciej Zięciak — home">Maciej Zięciak</a>

    <nav class="links" aria-label="Main">
      {links.map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>

    <div class="end">
      <a class="lang" href={alt.path} hreflang={alt.lang} aria-label={t.nav.switchLabel}>{alt.lang.toUpperCase()}</a>
      <a class="btn cta" href="#kontakt">{t.nav.cta}</a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="mobile-menu" data-burger>
        <span class="sr-only" data-burger-label data-open={t.nav.menu} data-close={t.nav.close}>{t.nav.menu}</span>
        <i></i><i></i>
      </button>
    </div>
  </div>

  <div class="sheet" id="mobile-menu" data-sheet hidden>
    <nav class="wrap sheet__in" aria-label="Mobile">
      {[...links, ['#kontakt', t.nav.contact]].map(([href, label]) => <a href={href}>{label}</a>)}
      <a class="sw" href={alt.path} hreflang={alt.lang}>{t.nav.switchLabel}</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    background: rgb(255 255 255 / 0.72);
    backdrop-filter: saturate(1.8) blur(20px);
    -webkit-backdrop-filter: saturate(1.8) blur(20px);
    transition: box-shadow 0.3s var(--ease);
  }
  .nav.is-scrolled {
    box-shadow: 0 1px 0 var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 56px;
  }
  .logo {
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }
  .links {
    display: flex;
    gap: 32px;
    font-size: 0.8125rem;
    color: var(--ink-2);
  }
  .links a {
    transition: color 0.2s;
  }
  .links a:hover {
    color: var(--ink);
  }
  .end {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .lang {
    font-size: 0.8125rem;
    color: var(--ink-2);
  }
  .lang:hover {
    color: var(--ink);
  }
  .cta {
    min-height: 34px;
    padding: 0 16px;
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .burger {
    display: none;
    position: relative;
    width: 40px;
    height: 40px;
  }
  .burger i {
    position: absolute;
    left: 11px;
    right: 11px;
    height: 1.5px;
    background: var(--ink);
    transition: transform 0.3s var(--ease);
  }
  .burger i:first-of-type { top: 16px; }
  .burger i:last-of-type { top: 23px; }
  .burger[aria-expanded='true'] i:first-of-type { transform: translateY(3.5px) rotate(45deg); }
  .burger[aria-expanded='true'] i:last-of-type { transform: translateY(-3.5px) rotate(-45deg); }

  .nav:has([aria-expanded='true']) {
    background: var(--white);
  }
  .sheet {
    position: fixed;
    inset: 56px 0 0;
    background: var(--white);
    overflow: auto;
  }
  .sheet__in {
    display: grid;
    padding-block: 20px 40px;
  }
  .sheet__in a {
    padding: 10px 0;
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.04em;
  }
  .sheet__in .sw {
    margin-top: 20px;
    font-size: 1.0625rem;
    font-weight: 500;
    color: #0066cc;
  }

  @media (max-width: 900px) {
    .links { display: none; }
  }
  @media (max-width: 600px) {
    .cta, .lang { display: none; }
    .burger { display: block; }
  }
</style>
