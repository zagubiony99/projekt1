---
import { site } from '../config';
import { getDict, type Lang } from '../i18n';
interface Props { lang: Lang }
const t = getDict(Astro.props.lang);
const c = t.contact;
---

<section class="section contact" id="kontakt" aria-labelledby="kontakt-h">
  <div class="wrap grid">
    <div class="left">
      <h2 class="h2" id="kontakt-h">{c.title}</h2>
      <p class="lead">{c.lead}</p>
      <div class="direct">
        <p>{c.orEmail}</p>
        <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
        {site.linkedin && <a class="mail" href={site.linkedin} rel="me noopener" target="_blank">LinkedIn ↗</a>}
      </div>
    </div>

    <form
      class="form"
      action={`mailto:${site.email}`}
      method="get"
      data-form
      data-email={site.email}
      data-subject={c.subject}
      data-l-topics={c.bodyTopics}
      data-l-url={c.bodyUrl}
    >
      <input type="hidden" name="subject" value={c.subject} />
      <fieldset>
        <legend>{c.topicsLabel}</legend>
        <div class="chips">
          {c.topics.map((tp) => (
            <label class="chip">
              <input type="checkbox" name="topic" value={tp} />
              <span>{tp}</span>
            </label>
          ))}
        </div>
      </fieldset>
      <label class="field">
        <span>{c.urlLabel}</span>
        <input type="url" name="url" placeholder={c.urlPlaceholder} autocomplete="url" inputmode="url" />
      </label>
      <label class="field">
        <span>{c.msgLabel}</span>
        <textarea name="body" rows="4" placeholder={c.msgPlaceholder} required></textarea>
      </label>
      <button class="btn submit" type="submit">{c.submit}</button>
    </form>
  </div>
</section>

<style>
  .contact {
    background: var(--forest);
    color: var(--white);
  }
  .contact ::selection {
    background: var(--green);
    color: var(--forest);
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px clamp(40px, 6vw, 96px);
    align-items: center;
  }
  .left {
    display: grid;
    gap: 24px;
  }
  .left .h2 {
    color: var(--green);
  }
  .left .lead {
    color: rgb(255 255 255 / 0.8);
    max-width: 30ch;
  }
  .direct {
    display: grid;
    gap: 4px;
    margin-top: 8px;
  }
  .direct p {
    color: rgb(255 255 255 / 0.6);
    font-size: 0.9375rem;
  }
  .mail {
    justify-self: start;
    font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    color: var(--green);
  }
  .mail:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .form {
    display: grid;
    gap: 22px;
    padding: clamp(24px, 3vw, 40px);
    border-radius: var(--r-lg);
    background: var(--white);
    color: var(--ink);
  }
  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
  }
  legend,
  .field > span {
    display: block;
    margin-bottom: 10px;
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .chip span {
    display: inline-block;
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--gray);
    color: var(--ink-2);
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
    user-select: none;
    transition: background-color 0.2s, color 0.2s;
  }
  .chip:hover span {
    background: var(--gray-2);
  }
  .chip input:checked + span {
    background: var(--forest);
    color: var(--green);
  }
  .chip input:focus-visible + span {
    outline: 2px solid var(--forest);
    outline-offset: 2px;
  }
  .field input,
  .field textarea {
    width: 100%;
    padding: 14px 16px;
    border-radius: 12px;
    border: 1.5px solid transparent;
    background: var(--gray);
    font-size: 1rem;
    resize: vertical;
    transition: border-color 0.2s, background-color 0.2s;
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--ink-3);
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--forest);
    background: var(--white);
  }
  .submit {
    justify-self: start;
  }
  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
