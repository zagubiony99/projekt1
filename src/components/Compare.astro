---
import { getDict, type Lang } from '../i18n';
interface Props { lang: Lang }
const t = getDict(Astro.props.lang);
const c = t.compare;
---

<!-- Pure typography: two columns of statements. As each row reaches the middle of the screen,
     "with me" lights up and the agency line is struck through and fades. -->
<section class="section cmp" aria-labelledby="cmp-h">
  <div class="wrap">
    <header class="head">
      <p class="eyebrow" data-reveal>{c.label}</p>
      <h2 class="h2" id="cmp-h" data-reveal>{c.title}</h2>
    </header>

    <div class="vs">
      <div class="cols" aria-hidden="true">
        <span></span>
        <span class="ai">{c.me}</span>
        <span class="them-h">{c.them}</span>
      </div>
      <dl>
        {c.rows.map((r) => (
          <div class="row" data-vs>
            <dt>{r.k}</dt>
            <dd class="me"><span class="ml ai">{c.me}</span><span class="sr-only">: </span>{r.me}</dd>
            <dd class="them"><span class="ml">{c.them}</span><span class="sr-only">: </span><s>{r.them}</s></dd>
          </div>
        ))}
      </dl>
      <p class="end" data-reveal>
        <a class="btn" href={`#${t.ids.contact}`} data-magnet>{t.hero.ctaPrimary}</a>
      </p>
    </div>
  </div>
</section>

<style>
  .vs {
    max-width: 1120px;
    margin-inline: auto;
  }
  .cols,
  .row {
    display: grid;
    grid-template-columns: minmax(150px, 0.55fr) 1fr 1fr;
    gap: 8px clamp(24px, 4vw, 64px);
  }
  .cols {
    padding-bottom: 18px;
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }
  .cols .ai {
    width: fit-content;
    padding-bottom: 0.06em;
  }
  .them-h {
    color: #aeaeb2;
  }
  .row {
    align-items: baseline;
    padding-block: clamp(22px, 2.6vw, 34px);
    border-top: 1px solid var(--line);
  }
  dt {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--muted);
  }
  dd {
    margin: 0;
    font-size: clamp(1.25rem, 1.02rem + 0.9vw, 1.875rem);
    line-height: 1.22;
    letter-spacing: -0.028em;
    text-wrap: balance;
  }
  /* column name repeated per row: only shown on phones, where the header row is hidden */
  .ml {
    display: none;
  }
  .me {
    font-weight: 650;
    color: var(--ink);
  }
  .them {
    font-weight: 500;
    color: #aeaeb2;
  }
  /* the strike is a drawn line, so it can sweep across */
  s {
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 58% / 100% 2px no-repeat;
  }
  .end {
    margin-top: clamp(40px, 5vw, 64px);
    text-align: center;
  }

  /* Scroll scene (JS + motion only): rows start undecided and resolve in the middle of the screen */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .me {
      color: #c7c7cc;
      transition: color 0.8s var(--ease-out);
    }
    :global(.js) .them {
      color: var(--ink-2);
      transition: color 0.9s var(--ease-out) 0.15s;
    }
    :global(.js) s {
      background-size: 0% 2px;
      transition: background-size 0.9s cubic-bezier(0.65, 0, 0.35, 1) 0.15s;
    }
    :global(.js) .row.hit .me { color: var(--ink); }
    :global(.js) .row.hit .them { color: #aeaeb2; }
    :global(.js) .row.hit s { background-size: 100% 2px; }
  }

  @media (max-width: 760px) {
    .cols { display: none; }
    .row {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .ml {
      display: block;
      width: fit-content;
      margin-bottom: 2px;
      font-size: 0.8125rem;
      font-weight: 600;
      letter-spacing: -0.01em;
    }
    .them .ml { color: #aeaeb2; }
    .them { font-size: 1.125rem; }
  }
</style>
