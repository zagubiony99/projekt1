---
import { site } from '../config';
import { getDict, otherLang, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang);
const alt = getDict(otherLang(lang));
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap row">
    <span>© {year} {site.name}</span>
    <nav aria-label="Footer">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      {site.linkedin && <a href={site.linkedin} rel="me noopener" target="_blank">LinkedIn</a>}
      <a href={alt.path} hreflang={alt.lang}>{t.nav.switchLabel}</a>
      <a href="#top">{t.footer.top} ↑</a>
    </nav>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--line);
    padding-block: 28px;
    color: var(--dim);
    font-size: 0.875rem;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 32px;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }
  a {
    transition: color 0.2s;
  }
  a:hover {
    color: var(--text);
  }
</style>
