---
import { getDict, type Lang } from '../i18n';
interface Props { lang: Lang }
const t = getDict(Astro.props.lang);
const s = t.services;
---

<section class="section" id="uslugi" aria-labelledby="uslugi-h">
  <div class="wrap">
    <header class="grid head">
      <p class="label" data-reveal>(02) {s.label}</p>
      <h2 class="display h2" id="uslugi-h" data-reveal>{s.title}</h2>
      <p class="lead muted" data-reveal style="--d:1">{s.intro}</p>
    </header>

    <ol class="list">
      {s.items.map((it, i) => (
        <li data-reveal style={`--d:${i % 3}`}>
          <details class="svc" name="svc" open={i === 0}>
            <summary>
              <span class="n mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="name display">{it.name}</span>
              <span class="tag mono">{it.tag}</span>
              <span class="plus" aria-hidden="true"></span>
            </summary>
            <div class="body grid">
              <p class="desc">{it.desc}</p>
              <div class="meta">
                <p class="mono k">{s.deliverablesLabel}</p>
                <ul>
                  {it.deliverables.map((d) => <li>{d}</li>)}
                </ul>
              </div>
              <div class="meta">
                <p class="mono k">{s.timeLabel}</p>
                <p class="time">{it.time}</p>
              </div>
            </div>
          </details>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .head {
    row-gap: 24px;
    margin-bottom: clamp(48px, 7vw, 112px);
    align-items: end;
  }
  .head .label { grid-column: 1 / -1; }
  .head h2 { grid-column: 1 / span 8; }
  .head .lead { grid-column: 9 / -1; justify-self: end; }

  .list {
    border-top: 1px solid var(--ink);
  }
  .list > li {
    border-bottom: 1px solid var(--ink);
  }
  summary {
    position: relative;
    display: grid;
    grid-template-columns: 72px 1fr auto 56px;
    align-items: center;
    gap: 16px;
    padding: clamp(18px, 2.4vw, 30px) 0;
    cursor: pointer;
    list-style: none;
    isolation: isolate;
    transition: color 0.4s var(--ease), padding 0.4s var(--ease);
  }
  summary::-webkit-details-marker { display: none; }
  summary::before {
    content: '';
    position: absolute;
    inset: 0 calc(-1 * var(--gutter));
    z-index: -1;
    background: var(--ink);
    clip-path: inset(100% 0 0 0);
    transition: clip-path 0.5s var(--ease);
  }
  @media (hover: hover) {
    summary:hover {
      color: var(--paper);
      padding-left: 12px;
    }
    summary:hover::before {
      clip-path: inset(0 0 0 0);
    }
    summary:hover .plus { background: var(--signal); }
  }
  .n { color: inherit; opacity: 0.6; }
  .name {
    font-size: clamp(2.25rem, 1rem + 4.6vw, 6rem);
    line-height: 0.9;
  }
  .tag {
    padding: 6px 10px;
    box-shadow: inset 0 0 0 1px currentColor;
    font-size: 0.6875rem;
    white-space: nowrap;
  }
  .plus {
    position: relative;
    justify-self: end;
    width: 44px;
    height: 44px;
    background: var(--paper-2);
    transition: background-color 0.3s, transform 0.5s var(--ease);
  }
  .plus::before,
  .plus::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 16px;
    height: 2px;
    background: var(--ink);
    translate: -50% -50%;
  }
  .plus::after { rotate: 90deg; }
  details[open] .plus {
    background: var(--signal);
  }
  .plus::before,
  .plus::after {
    transition: rotate 0.5s var(--ease);
  }
  details[open] .plus::before { rotate: 45deg; }
  details[open] .plus::after { rotate: 135deg; }

  .body {
    padding: 4px 0 clamp(28px, 3.4vw, 48px);
    row-gap: 28px;
  }
  details[open] .body {
    animation: open 0.6s var(--ease);
  }
  @keyframes open {
    from { opacity: 0; transform: translateY(-10px); }
  }
  .desc {
    grid-column: 2 / span 5;
    font-size: var(--fs-lead);
    line-height: 1.4;
    font-stretch: 92%;
  }
  .meta:nth-of-type(1) { grid-column: 8 / span 3; }
  .meta:nth-of-type(2) { grid-column: 11 / span 2; }
  .k {
    color: var(--ink-2);
    margin-bottom: 12px;
  }
  .meta ul li {
    position: relative;
    padding: 8px 0 8px 22px;
    border-top: 1px solid var(--line);
    font-size: 0.9375rem;
  }
  .meta ul li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--signal);
    font-family: var(--f-mono);
  }
  .time {
    font-size: clamp(1.5rem, 1rem + 1.4vw, 2.25rem);
    font-stretch: 70%;
    font-weight: 700;
    text-transform: uppercase;
    line-height: 1;
  }

  @media (max-width: 1080px) {
    .head h2, .head .lead { grid-column: 1 / -1; justify-self: start; }
    .desc { grid-column: 1 / -1; }
    .meta:nth-of-type(1) { grid-column: 1 / span 8; }
    .meta:nth-of-type(2) { grid-column: 9 / -1; }
  }
  @media (max-width: 640px) {
    summary { grid-template-columns: 36px 1fr 44px; }
    .tag { display: none; }
    .meta:nth-of-type(1), .meta:nth-of-type(2) { grid-column: 1 / -1; }
  }
</style>
