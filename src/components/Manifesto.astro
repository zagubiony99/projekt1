---
import { getDict, type Lang } from '../i18n';
interface Props { lang: Lang }
const t = getDict(Astro.props.lang);
const m = t.manifesto;

// Pre-split into words at build time; one CSS var (--p, set on scroll) lights them up in order.
let i = 0;
const parts = m.parts.map((p) => {
  const words = p.t.split(/(\s+)/).filter((w) => w.length);
  const out = words.map((w) => (/^\s+$/.test(w) ? { space: true, w } : { w, i: i++ }));
  return { ...p, words: out, start: i - out.filter((w) => !('space' in w)).length, end: i - 1 };
});
const n = i;
---

<section class="section dark manifesto" aria-label={m.label} data-scrub style={`--n:${n}`}>
  <div class="wrap">
    <p class="pill">{m.label}</p>
    <p class="txt">
      {parts.map((p) => {
        const words = p.words.map((w) =>
          'space' in w ? w.w : <span class="w" style={`--i:${w.i}`}>{w.w}</span>
        );
        const span = `--s:${p.start};--e:${p.end}`;
        if ('strike' in p && p.strike) return <s class="strike" style={span}>{words}</s>;
        if ('mark' in p && p.mark) return <mark class="mark" style={span}>{words}</mark>;
        return words;
      })}
    </p>
  </div>
</section>

<style>
  .txt {
    margin-top: 36px;
    max-width: 18em;
    font-size: clamp(2.25rem, 1rem + 4.6vw, 6rem);
    line-height: 1;
    font-weight: 740;
    letter-spacing: -0.045em;
  }
  .w {
    opacity: clamp(0.18, calc(var(--p) * var(--n) - var(--i)), 1);
  }
  /* Inline backgrounds so strike/highlight wrap correctly across lines. */
  .strike,
  .mark {
    color: inherit;
    background-color: transparent;
    text-decoration: none;
    background-repeat: no-repeat;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .strike {
    --k: clamp(0, calc((var(--p) * var(--n) - var(--e) - 1) / 2), 1);
    background-image: linear-gradient(var(--coral), var(--coral));
    background-position: 0 58%;
    background-size: calc(var(--k, 1) * 100%) 0.1em;
  }
  .mark {
    --k: clamp(0, calc((var(--p) * var(--n) - var(--s)) / (var(--e) - var(--s) + 1)), 1);
    padding: 0 0.08em;
    border-radius: 0.12em;
    background-image: linear-gradient(var(--lime), var(--lime));
    background-position: 0 0;
    background-size: calc(var(--k, 1) * 100%) 100%;
  }
  /* Lime text on forest until the highlight sweeps in, then forest on lime. */
  .mark .w {
    opacity: 1;
    color: color-mix(in srgb, var(--forest) calc(var(--k, 1) * 100%), var(--lime));
  }
</style>
