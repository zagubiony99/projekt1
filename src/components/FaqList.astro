---
// Accordion of questions (open/close animation is in scripts/main.ts via [data-acc]).
interface Props { items: readonly { q: string; a: string }[] }
const { items } = Astro.props;
---

<div class="faq">
  {items.map((f, i) => (
    <details class="q" open={i === 0} data-acc>
      <summary><span>{f.q}</span><span class="pm" aria-hidden="true"></span></summary>
      <p class="a">{f.a}</p>
    </details>
  ))}
</div>

<style>
  .faq {
    max-width: 860px;
    margin-inline: auto;
    display: grid;
    gap: 12px;
  }
  .q {
    border-radius: var(--r);
    background: var(--white);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 24px 28px;
    cursor: pointer;
    list-style: none;
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--blue); }
  .pm {
    position: relative;
    flex: none;
    width: 22px;
    height: 22px;
    transition: transform 0.4s var(--ease-out);
  }
  .pm::before,
  .pm::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 16px;
    height: 1.75px;
    border-radius: 2px;
    background: currentColor;
    translate: -50% -50%;
  }
  .pm::after { rotate: 90deg; }
  .q[open] .pm { transform: rotate(45deg); }
  .a {
    padding: 0 28px 26px;
    color: var(--muted);
    font-size: 1.0625rem;
    transition: opacity 0.4s var(--ease-out), transform 0.4s var(--ease-out);
  }
  .q.is-closing .a { opacity: 0; transform: translateY(-8px); }
</style>
