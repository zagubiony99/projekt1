---
import { site } from '../config';
import { getDict, otherLang, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang);
const alt = getDict(otherLang(lang));
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap row">
    <span>Copyright © {year} {site.name}. {t.footer.rights}</span>
    <nav aria-label="Footer">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      {site.linkedin && <a href={site.linkedin} rel="me noopener" target="_blank">LinkedIn</a>}
      <a href={alt.path} hreflang={alt.lang}>{t.nav.switchLabel}</a>
      <a href="#top">{t.footer.top}</a>
    </nav>
  </div>
</footer>

<style>
  .foot {
    background: var(--gray);
    padding-block: 22px;
    color: var(--ink-3);
    font-size: 0.75rem;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px 32px;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
  }
  nav a {
    color: var(--ink-2);
  }
  nav a:hover {
    text-decoration: underline;
  }
</style>
