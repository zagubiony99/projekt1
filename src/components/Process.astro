---
import { getDict, type Lang } from '../i18n';
interface Props { lang: Lang }
const t = getDict(Astro.props.lang);
const p = t.process;
---

<section class="section" id="proces" aria-labelledby="proces-h">
  <div class="wrap">
    <header class="center-head">
      <p class="eyebrow" data-reveal>{p.label}</p>
      <h2 class="h2" id="proces-h" data-reveal>{p.title}</h2>
    </header>
    <ol class="steps">
      {p.steps.map((s, i) => (
        <li class="step" data-reveal style={`--d:${i}`}>
          <span class="bar" aria-hidden="true"><i style={`--w:${(i + 1) * 25}%`}></i></span>
          <h3>{s.name}</h3>
          <p>{s.desc}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(24px, 3vw, 40px);
  }
  .bar {
    display: block;
    height: 6px;
    border-radius: 6px;
    background: var(--gray-2);
    margin-bottom: 24px;
    overflow: hidden;
  }
  .bar i {
    display: block;
    width: var(--w);
    height: 100%;
    border-radius: 6px;
    background: var(--green);
  }
  h3 {
    font-size: 1.5rem;
    font-weight: 750;
    letter-spacing: -0.04em;
    color: var(--forest);
  }
  p {
    margin-top: 8px;
    color: var(--ink-2);
    font-size: 1rem;
  }
  @media (max-width: 900px) {
    .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 48px; }
  }
  @media (max-width: 520px) {
    .steps { grid-template-columns: 1fr; }
  }
</style>
