---
import { getDict, otherLang, type Lang } from '../i18n';
interface Props { lang: Lang; altHref?: string }
const { lang } = Astro.props;
const t = getDict(lang);
const alt = getDict(otherLang(lang));
const altHref = Astro.props.altHref ?? alt.path;
// anchors always point at the homepage sections, so they work from service pages too
const h = (a: string) => `${t.path}${a}`;
const links = [
  [h('#uslugi'), t.nav.services],
  [h('#doswiadczenie'), t.nav.experience],
  [h('#proces'), t.nav.process],
  [h('#faq'), t.nav.faq],
] as const;
---

<header class="nav" data-nav>
  <div class="wrap wrap--wide bar">
    <a class="logo" href={t.path} aria-label="Maciej Zięciak — home">Maciej Zięciak</a>
    <div class="end">
      <nav class="links" aria-label="Main">
        {links.map(([href, label]) => <a href={href}>{label}</a>)}
        <a href={altHref} hreflang={alt.lang} aria-label={t.nav.switchLabel}>{alt.lang.toUpperCase()}</a>
      </nav>
      <a class="cta" href="#kontakt">{t.nav.cta}</a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="mobile-menu" data-burger>
        <span class="sr-only" data-burger-label data-open={t.nav.menu} data-close={t.nav.close}>{t.nav.menu}</span>
        <i></i><i></i>
      </button>
    </div>
  </div>

  <div class="sheet" id="mobile-menu" data-sheet hidden>
    <nav class="wrap sheet__in" aria-label="Mobile">
      {[...links, ['#kontakt', t.nav.contact]].map(([href, label]) => <a href={href}>{label}</a>)}
      <a class="sw" href={altHref} hreflang={alt.lang}>{t.nav.switchLabel}</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    background: rgb(251 251 253 / 0.8);
    backdrop-filter: saturate(1.8) blur(20px);
    -webkit-backdrop-filter: saturate(1.8) blur(20px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s var(--ease), background-color 0.3s var(--ease);
  }
  .nav.is-scrolled {
    border-bottom-color: rgb(0 0 0 / 0.08);
  }
  .nav.is-dark {
    background: rgb(22 22 23 / 0.8);
    border-bottom-color: rgb(255 255 255 / 0.08);
    color: #f5f5f7;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 52px;
  }
  .logo {
    font-size: 1.3125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .end {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .links {
    display: flex;
    gap: 24px;
    font-size: 0.75rem;
    letter-spacing: -0.01em;
  }
  .links a {
    opacity: 0.8;
    transition: opacity 0.2s;
  }
  .links a:hover {
    opacity: 1;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 0 12px;
    border-radius: 999px;
    background: var(--blue);
    color: #fff;
    font-size: 0.75rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .cta:hover {
    background: var(--blue-hover);
  }
  .burger {
    display: none;
    position: relative;
    width: 36px;
    height: 36px;
  }
  .burger i {
    position: absolute;
    left: 10px;
    right: 10px;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.3s var(--ease);
  }
  .burger i:first-of-type { top: 14px; }
  .burger i:last-of-type { top: 21px; }
  .burger[aria-expanded='true'] i:first-of-type { transform: translateY(3.5px) rotate(45deg); }
  .burger[aria-expanded='true'] i:last-of-type { transform: translateY(-3.5px) rotate(-45deg); }

  .nav:has([aria-expanded='true']) {
    background: var(--white);
    color: var(--ink);
  }
  .sheet {
    position: fixed;
    inset: 52px 0 0;
    background: var(--white);
    color: var(--ink);
    overflow: auto;
  }
  .sheet__in {
    display: grid;
    padding-block: 16px 40px;
  }
  .sheet__in a {
    padding: 8px 0;
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .sheet__in .sw {
    margin-top: 16px;
    font-size: 1.0625rem;
    font-weight: 400;
    color: var(--link);
  }
  @media (max-width: 760px) {
    .links { display: none; }
    .burger { display: block; }
    .end { gap: 12px; }
  }
</style>
