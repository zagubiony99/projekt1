---
import { getDict, type Lang } from '../i18n';
interface Props { lang: Lang }
const t = getDict(Astro.props.lang);
const f = t.faq;
---

<section class="section" id="faq" aria-labelledby="faq-h">
  <div class="wrap grid">
    <header>
      <p class="eyebrow">{f.label}</p>
      <h2 class="h2" id="faq-h">{f.title}</h2>
    </header>
    <div class="items">
      {f.items.map((it, i) => (
        <details class="q" name="faq" open={i === 0}>
          <summary>
            <span>{it.q}</span>
            <span class="pm" aria-hidden="true"></span>
          </summary>
          <p class="a">{it.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 40px clamp(40px, 6vw, 96px);
    align-items: start;
  }
  header {
    display: grid;
    gap: 20px;
    position: sticky;
    top: 110px;
  }
  .items {
    border-top: 1px solid var(--line);
  }
  .q {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 22px 0;
    cursor: pointer;
    list-style: none;
    font-size: 1.125rem;
    font-weight: 520;
    letter-spacing: -0.02em;
    transition: color 0.2s;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: #fff; }
  .pm {
    position: relative;
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--line-2);
    transition: transform 0.3s var(--ease), background-color 0.2s;
  }
  .pm::before,
  .pm::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 10px;
    height: 1.5px;
    background: var(--text);
    translate: -50% -50%;
  }
  .pm::after { rotate: 90deg; }
  .q[open] .pm {
    transform: rotate(45deg);
    background: var(--accent);
    box-shadow: none;
  }
  .q[open] .pm::before,
  .q[open] .pm::after { background: var(--bg); }
  .a {
    padding-bottom: 24px;
    max-width: 62ch;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; }
    header { position: static; }
  }
</style>
