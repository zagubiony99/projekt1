---
import { getDict, type Lang } from '../i18n';
interface Props { lang: Lang }
const t = getDict(Astro.props.lang);
---

<div class="ticker">
  <p class="sr-only">{t.ticker.join(', ')}</p>
  {[0, 1].map(() => (
    <ul class="track" aria-hidden="true">
      {t.ticker.map((item) => (
        <li>
          {item}
          <svg viewBox="0 0 24 24" class="star"><path d="M12 0C13 8 16 11 24 12 16 13 13 16 12 24 11 16 8 13 0 12 8 11 11 8 12 0Z" /></svg>
        </li>
      ))}
    </ul>
  ))}
</div>

<style>
  .ticker {
    display: flex;
    overflow: hidden;
    background: var(--lime);
    color: var(--forest);
    padding-block: clamp(10px, 1.2vw, 18px) clamp(22px, 2.4vw, 34px);
  }
  .track {
    flex: none;
    display: flex;
    font-size: clamp(1.75rem, 1rem + 2.6vw, 3.5rem);
    font-weight: 760;
    letter-spacing: -0.04em;
    line-height: 1;
    animation: marquee 44s linear infinite;
  }
  .ticker:hover .track {
    animation-play-state: paused;
  }
  li {
    display: flex;
    align-items: center;
    white-space: nowrap;
  }
  .star {
    width: 0.6em;
    height: 0.6em;
    margin-inline: 0.5em;
    fill: var(--forest);
    animation: spin 10s linear infinite;
  }
  @keyframes marquee {
    to { transform: translateX(-100%); }
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>
