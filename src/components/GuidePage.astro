---
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import PageHero from './PageHero.astro';
import FaqList from './FaqList.astro';
import GuideCards from './GuideCards.astro';
import { site } from '../config';
import { getDict, otherLang, type Lang } from '../i18n';
import { guides, mcpServer } from '../data/pages';
import { services, ui } from '../data/services';
import { pageRoutes } from '../data/routes';
import { ogPath } from '../data/og';
interface Props { lang: Lang; key: string }
const { lang, key } = Astro.props;
const other = otherLang(lang);
const t = getDict(lang);
const u = t.guidesUi;
const pair = guides.find((g) => g.key === key)!;
const g = pair[lang];
const path = g.path;
const altPath = pair[other].path;
const url = new URL(path, site.url).href;
const home = new URL(t.path, site.url).href;
const index = new URL(pageRoutes.guides[lang], site.url).href;
const svc = services.find((s) => s.key === pair.service);
const svcHref = svc ? `${ui[lang].base}${svc[lang].slug}/` : null;
const contactHref = `${t.path}#${t.ids.contact}`;
const fmt = new Intl.DateTimeFormat(lang === 'pl' ? 'pl-PL' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const updated = fmt.format(new Date(pair.updated));
const inLanguage = lang === 'pl' ? 'pl-PL' : 'en-GB';

const extraLd = [
  {
    '@type': 'Article',
    '@id': `${url}#article`,
    headline: g.title,
    description: g.metaDescription,
    inLanguage,
    datePublished: pair.published,
    dateModified: pair.updated,
    author: { '@id': `${site.url}/#person` },
    publisher: { '@id': `${site.url}/#person` },
    image: new URL(ogPath(lang, `guide-${key}`), site.url).href,
    mainEntityOfPage: { '@id': `${url}#webpage` },
    ...(svc ? { about: { '@type': 'Thing', name: svc[lang].name } } : {}),
  },
  {
    '@type': 'WebPage',
    '@id': `${url}#webpage`,
    url,
    name: g.metaTitle,
    description: g.metaDescription,
    inLanguage,
    isPartOf: { '@id': `${site.url}/#website` },
    breadcrumb: { '@id': `${url}#breadcrumb` },
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${url}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.serviceUi.home, item: home },
      { '@type': 'ListItem', position: 2, name: t.nav.guides, item: index },
      { '@type': 'ListItem', position: 3, name: g.title, item: url },
    ],
  },
  {
    '@type': 'FAQPage',
    '@id': `${url}#faq`,
    mainEntity: g.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<Base lang={lang} title={g.metaTitle} description={g.metaDescription} path={path} altPath={altPath} extraLd={extraLd} ogImage={ogPath(lang, `guide-${key}`)}>
  <Nav lang={lang} altHref={altPath} contactHref={contactHref} />
  <main id="main">
    <PageHero
      compact
      eyebrowInH1={false}
      crumbs={[{ href: t.path, label: t.serviceUi.home }, { href: pageRoutes.guides[lang], label: t.nav.guides }, { label: g.title }]}
      eyebrow={u.eyebrow}
      title={g.title}
      lead={g.lead}
    >
      <p class="meta intro">
        <span>{u.by} <a href={pageRoutes.about[lang]} rel="author">{site.name}</a></span>
        <span>{u.updated}: <time datetime={pair.updated}>{updated}</time></span>
        <span>{g.minutes} {u.readTime}</span>
      </p>
    </PageHero>

    <div class="wrap wrap--wide layout">
      <aside class="toc" aria-labelledby="toc-h">
        <p class="toc-h" id="toc-h">{u.toc}</p>
        <ol>{g.sections.map((s) => <li><a href={`#${s.id}`}>{s.h}</a></li>)}</ol>
      </aside>

      <article class="article">
        {g.sections.map((s) => (
          <section aria-labelledby={s.id}>
            <h2 id={s.id}>{s.h}</h2>
            <div class="body" set:html={s.body} />
          </section>
        ))}

        {key === 'chatgpt-apps' && (
          <aside class="demo" aria-label={mcpServer[lang].demoTitle}>
            <p class="demo-h">{mcpServer[lang].demoTitle}</p>
            <p class="demo-d">{mcpServer[lang].demoText}</p>
            <a class="more" href={pageRoutes.mcpServer[lang]}>{mcpServer[lang].demoCta}</a>
          </aside>
        )}

        {svc && svcHref && (
          <aside class="svc" aria-label={svc[lang].name}>
            <p class="svc-h">{u.serviceTitle}</p>
            <p class="svc-n">{svc[lang].name}</p>
            <p class="svc-d">{svc[lang].card.desc}</p>
            <div class="svc-ctas">
              <a class="btn" href={svcHref}>{u.serviceCta}</a>
              <a class="more" href={contactHref}>{t.nav.cta}</a>
            </div>
          </aside>
        )}
      </article>
    </div>

    <section class="section section--gray" aria-labelledby="gfaq-h">
      <div class="wrap">
        <header class="head">
          <h2 class="h2" id="gfaq-h" data-reveal>{u.faqTitle}</h2>
        </header>
        <FaqList items={g.faq} />
      </div>
    </section>

    <section class="section" aria-labelledby="more-h">
      <div class="wrap wrap--wide">
        <header class="head">
          <h2 class="h2" id="more-h" data-reveal>{u.others}</h2>
        </header>
        <GuideCards lang={lang} exclude={key} limit={2} tool />
      </div>
    </section>
  </main>
  <Footer lang={lang} altHref={altPath} contactHref={contactHref} />
</Base>

<script>
  import '../scripts/main.ts';

  // Table of contents: highlight the section being read
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('.toc a')].map((a) => [a.hash.slice(1), a]));
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        links.forEach((a) => a.classList.remove('on'));
        links.get(e.target.id)?.classList.add('on');
      }
    },
    { rootMargin: '-15% 0px -75% 0px' },
  );
  document.querySelectorAll('.article h2[id]').forEach((h) => io.observe(h));
</script>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 18px;
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .meta a {
    color: var(--link);
  }
  .layout {
    display: grid;
    grid-template-columns: 240px minmax(0, 720px);
    justify-content: center;
    gap: clamp(32px, 5vw, 72px);
    padding-bottom: clamp(64px, 8vw, 112px);
  }
  .toc {
    position: sticky;
    top: 84px;
    align-self: start;
    font-size: 0.875rem;
  }
  .toc-h {
    margin-bottom: 12px;
    font-weight: 650;
  }
  .toc ol {
    display: grid;
    gap: 2px;
    padding: 0;
    list-style: none;
    border-left: 1px solid var(--line);
  }
  .toc a {
    display: block;
    padding: 6px 0 6px 14px;
    margin-left: -1px;
    border-left: 2px solid transparent;
    color: var(--muted);
    transition: color 0.2s, border-color 0.2s;
  }
  .toc a:hover,
  .toc a.on {
    color: var(--ink);
    border-left-color: var(--a1);
  }
  .article section {
    scroll-margin-top: 80px;
  }
  .article section + section {
    margin-top: clamp(40px, 5vw, 56px);
  }
  .article h2 {
    margin-bottom: 16px;
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.15;
    scroll-margin-top: 80px;
  }
  /* article body comes from the CMS as HTML */
  .body {
    color: var(--ink-2);
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  .body :global(> * + *) {
    margin-top: 16px;
  }
  .body :global(ul),
  .body :global(ol) {
    display: grid;
    gap: 8px;
    padding-left: 1.3em;
  }
  .body :global(ul) {
    list-style: disc;
  }
  .body :global(ol) {
    list-style: decimal;
  }
  .body :global(li::marker) {
    color: var(--muted);
  }
  .body :global(strong) {
    color: var(--ink);
    font-weight: 650;
  }
  .body :global(a) {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .body :global(code) {
    padding: 2px 6px;
    border-radius: 6px;
    background: var(--gray);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.875em;
  }
  .body :global(pre) {
    overflow-x: auto;
    padding: 20px 22px;
    border-radius: var(--r);
    background: var(--dark);
    color: #f5f5f7;
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .body :global(pre code) {
    padding: 0;
    background: none;
    color: inherit;
    font-size: inherit;
  }
  .body :global(table) {
    display: block;
    overflow-x: auto;
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .body :global(th),
  .body :global(td) {
    padding: 10px 14px 10px 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .body :global(th) {
    color: var(--ink);
    font-weight: 650;
  }
  .svc {
    margin-top: clamp(48px, 6vw, 72px);
    padding: clamp(28px, 4vw, 40px);
    border-radius: var(--r-lg);
    background: var(--dark);
    background-image: radial-gradient(110% 90% at 100% 0%, color-mix(in srgb, var(--a2) 28%, transparent), transparent 60%);
    color: #fff;
  }
  .svc-h {
    color: var(--dark-muted);
    font-weight: 600;
  }
  .svc-n {
    margin-top: 6px;
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.035em;
  }
  .svc-d {
    margin-top: 10px;
    max-width: 52ch;
    color: var(--dark-muted);
  }
  .svc-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 28px;
    margin-top: 22px;
  }
  .svc .more {
    color: var(--link-dark);
  }
  @media (max-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, 720px);
    }
    .toc {
      position: static;
      padding: 20px 22px;
      border-radius: var(--r);
      background: var(--gray);
    }
  }
  .demo {
    margin-top: 48px;
    padding: clamp(22px, 3vw, 30px);
    border: 1px solid color-mix(in srgb, var(--a1) 22%, var(--line));
    border-radius: var(--r-lg);
    background: color-mix(in srgb, var(--a1) 5%, var(--white));
  }
  .demo + .svc {
    margin-top: 16px;
  }
  .demo-h {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .demo-d {
    margin: 6px 0 12px;
    color: var(--ink-2);
  }
</style>
