---
import { site } from '../config';
import { getDict, type Lang } from '../i18n';
interface Props { lang: Lang }
const t = getDict(Astro.props.lang);
const c = t.contact;
---

<section class="section contact" id="kontakt" aria-labelledby="kontakt-h">
  <div class="wrap grid">
    <div class="left">
      <h2 id="kontakt-h">{c.title}</h2>
      <p class="lead">{c.lead}</p>
      <div class="direct">
        <p>{c.orEmail}</p>
        <a class="mail" href={`mailto:${site.email}`}>{site.email} <span aria-hidden="true">↗</span></a>
      </div>
    </div>

    <form
      class="form"
      action={`mailto:${site.email}`}
      method="get"
      data-form
      data-email={site.email}
      data-subject={c.subject}
      data-l-topics={c.bodyTopics}
      data-l-url={c.bodyUrl}
    >
      <input type="hidden" name="subject" value={c.subject} />
      <fieldset>
        <legend>{c.topicsLabel}</legend>
        <div class="chips">
          {c.topics.map((tp) => (
            <label class="tchip">
              <input type="checkbox" name="topic" value={tp} />
              <span>{tp}</span>
            </label>
          ))}
        </div>
      </fieldset>
      <label class="field">
        <span>{c.urlLabel}</span>
        <input type="url" name="url" placeholder={c.urlPlaceholder} autocomplete="url" inputmode="url" />
      </label>
      <label class="field">
        <span>{c.msgLabel}</span>
        <textarea name="body" rows="4" placeholder={c.msgPlaceholder} required></textarea>
      </label>
      <button class="btn btn--lime submit" type="submit">{c.submit} <span class="arrow" aria-hidden="true">→</span></button>
    </form>
  </div>
</section>

<style>
  .contact {
    background: var(--lime);
    color: var(--forest);
  }
  .contact ::selection {
    background: var(--forest);
    color: var(--lime);
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }
  .left {
    display: grid;
    gap: 28px;
    justify-items: start;
  }
  h2 {
    font-size: clamp(4rem, 1.4rem + 10vw, 12rem);
    line-height: 0.85;
    letter-spacing: -0.06em;
    font-weight: 800;
  }
  .lead {
    max-width: 30ch;
  }
  .direct {
    margin-top: 12px;
    display: grid;
    gap: 6px;
  }
  .direct p {
    font-weight: 550;
    opacity: 0.7;
  }
  .mail {
    font-size: clamp(1.375rem, 1rem + 1.4vw, 2.25rem);
    font-weight: 760;
    letter-spacing: -0.035em;
    word-break: break-word;
    background: linear-gradient(var(--forest), var(--forest)) 0 100% / 100% 3px no-repeat;
    transition: background-size 0.4s var(--ease);
  }
  .mail:hover {
    background-size: 0 3px;
    background-position: 100% 100%;
  }
  .form {
    display: grid;
    gap: 28px;
    padding: clamp(24px, 3vw, 44px);
    border-radius: var(--r-lg);
    background: var(--forest);
    color: var(--cream);
    transform: rotate(1deg);
    box-shadow: 0 30px 60px -30px rgb(10 31 25 / 0.6);
  }
  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
  }
  legend,
  .field > span {
    display: block;
    margin-bottom: 12px;
    font-weight: 600;
    font-size: 1rem;
    color: var(--mist);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tchip input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .tchip span {
    display: inline-block;
    padding: 10px 16px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1.5px rgb(244 239 227 / 0.35);
    font-size: 0.9375rem;
    font-weight: 560;
    cursor: pointer;
    user-select: none;
    transition: background-color 0.2s, color 0.2s, box-shadow 0.2s, transform 0.3s var(--spring);
  }
  .tchip:hover span {
    box-shadow: inset 0 0 0 1.5px var(--cream);
  }
  .tchip input:checked + span {
    background: var(--lime);
    color: var(--forest);
    box-shadow: none;
    transform: rotate(-2deg);
  }
  .tchip input:focus-visible + span {
    outline: 3px solid var(--coral);
    outline-offset: 2px;
  }
  .field {
    display: block;
  }
  .field input,
  .field textarea {
    width: 100%;
    padding: 16px 18px;
    border: 1.5px solid transparent;
    border-radius: var(--r-sm);
    background: var(--forest-2);
    color: var(--cream);
    font-size: 1.0625rem;
    resize: vertical;
    transition: border-color 0.2s, background-color 0.2s;
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: rgb(244 239 227 / 0.45);
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--lime);
    background: #1b4337;
  }
  .submit {
    justify-self: start;
  }
  @media (max-width: 960px) {
    .grid { grid-template-columns: 1fr; }
    .form { transform: none; }
  }
</style>
