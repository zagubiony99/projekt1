---
import { site } from '../config';
import { getDict, type Lang } from '../i18n';
interface Props { lang: Lang }
const t = getDict(Astro.props.lang);
const c = t.contact;
---

<section class="section contact" id="kontakt" aria-labelledby="kontakt-h">
  <div class="glow" aria-hidden="true"></div>
  <div class="wrap grid">
    <div class="left">
      <p class="eyebrow">{c.label}</p>
      <h2 class="h2" id="kontakt-h">{c.title}</h2>
      <p class="lead">{c.lead}</p>
      <div class="direct">
        <p>{c.orEmail}</p>
        <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
        {site.linkedin && <a class="mail li" href={site.linkedin} rel="me noopener" target="_blank">LinkedIn ↗</a>}
      </div>
    </div>

    <form
      class="form"
      action={`mailto:${site.email}`}
      method="get"
      data-form
      data-email={site.email}
      data-subject={c.subject}
      data-l-topics={c.bodyTopics}
      data-l-url={c.bodyUrl}
    >
      <input type="hidden" name="subject" value={c.subject} />
      <fieldset>
        <legend>{c.topicsLabel}</legend>
        <div class="chips">
          {c.topics.map((tp) => (
            <label class="chip">
              <input type="checkbox" name="topic" value={tp} />
              <span>{tp}</span>
            </label>
          ))}
        </div>
      </fieldset>
      <label class="field">
        <span>{c.urlLabel}</span>
        <input type="url" name="url" placeholder={c.urlPlaceholder} autocomplete="url" inputmode="url" />
      </label>
      <label class="field">
        <span>{c.msgLabel}</span>
        <textarea name="body" rows="4" placeholder={c.msgPlaceholder} required></textarea>
      </label>
      <button class="btn btn--accent submit" type="submit">{c.submit} <span class="arrow" aria-hidden="true">→</span></button>
    </form>
  </div>
</section>

<style>
  .contact {
    overflow: hidden;
  }
  .glow {
    position: absolute;
    inset: auto -10% -40% -10%;
    height: 600px;
    background: radial-gradient(600px 300px at 30% 60%, rgb(212 255 79 / 0.06), transparent 70%);
    pointer-events: none;
  }
  .grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px clamp(40px, 6vw, 96px);
    align-items: start;
  }
  .left {
    display: grid;
    gap: 22px;
    justify-items: start;
  }
  .direct {
    display: grid;
    gap: 6px;
    margin-top: 12px;
  }
  .direct p {
    color: var(--dim);
    font-size: 0.875rem;
  }
  .mail {
    justify-self: start;
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    font-weight: 520;
    letter-spacing: -0.02em;
    border-bottom: 1px solid var(--line-2);
    transition: border-color 0.2s, color 0.2s;
  }
  .mail:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .form {
    display: grid;
    gap: 22px;
    padding: clamp(22px, 3vw, 32px);
    border-radius: var(--r-lg);
    border: 1px solid var(--line-2);
    background: var(--bg-2);
  }
  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
  }
  legend,
  .field > span {
    display: block;
    margin-bottom: 10px;
    color: var(--muted);
    font-size: 0.875rem;
    font-weight: 500;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chip input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .chip span {
    display: inline-block;
    padding: 7px 13px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line-2);
    color: var(--muted);
    font-size: 0.875rem;
    cursor: pointer;
    user-select: none;
    transition: background-color 0.2s, color 0.2s, box-shadow 0.2s;
  }
  .chip:hover span {
    color: var(--text);
  }
  .chip input:checked + span {
    background: var(--accent);
    color: var(--bg);
    box-shadow: none;
  }
  .chip input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .field input,
  .field textarea {
    width: 100%;
    padding: 12px 14px;
    border-radius: 10px;
    border: 1px solid var(--line-2);
    background: var(--bg);
    font-size: 0.9375rem;
    resize: vertical;
    transition: border-color 0.2s;
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--dim);
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--accent);
  }
  .submit {
    justify-self: start;
  }
  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
