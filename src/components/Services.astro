---
import { getDict, type Lang } from '../i18n';
interface Props { lang: Lang }
const t = getDict(Astro.props.lang);
const s = t.services;
---

<section class="section section--gray" id="uslugi" aria-labelledby="uslugi-h">
  <div class="wrap">
    <header class="head">
      <p class="eyebrow" data-reveal>{s.label}</p>
      <h2 class="h2" id="uslugi-h" data-reveal>{s.title}</h2>
      <p class="lead" data-reveal style="--d:1">{s.intro}</p>
    </header>
  </div>
  <div class="wrap wrap--wide">
    <ul class="tiles">
      {s.items.map((it, i) => (
        <li class:list={['tile', { dark: i === 1 }]} data-reveal data-tilt style={`--d:${i % 2}`}>
          <h3 class:list={{ ai: i === 1 }}>{it.name}</h3>
          <p>{it.desc}</p>
          <p class="tags">{it.tags.join(' · ')}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .tile {
    --mx: 50%;
    --my: 50%;
    --rx: 0deg;
    --ry: 0deg;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-height: 380px;
    padding: clamp(32px, 4vw, 56px);
    border-radius: var(--r-lg);
    background: var(--white);
    transform: perspective(1200px) rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform 0.5s var(--ease-out), box-shadow 0.6s var(--ease-out);
  }
  /* spotlight that follows the cursor */
  .tile::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(420px circle at var(--mx) var(--my), rgb(0 113 227 / 0.08), transparent 60%);
    opacity: 0;
    transition: opacity 0.4s;
  }
  .dark::before {
    background: radial-gradient(460px circle at var(--mx) var(--my), rgb(201 89 221 / 0.28), rgb(8 148 255 / 0.1) 40%, transparent 65%);
  }
  .tile:hover::before {
    opacity: 1;
  }
  .tile:hover {
    box-shadow: 0 30px 60px -28px rgb(0 0 0 / 0.25);
  }
  .tile.is-in:hover {
    transition: transform 0.15s linear, box-shadow 0.6s var(--ease-out);
  }
  h3 {
    font-size: clamp(1.875rem, 1.4rem + 1.4vw, 2.75rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
    font-weight: 650;
    text-wrap: balance;
  }
  .tile > p:not(.tags) {
    color: var(--muted);
    font-size: 1.1875rem;
    line-height: 1.42;
    max-width: 44ch;
  }
  .tags {
    margin-top: auto;
    padding-top: 16px;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .dark {
    background: var(--black);
    color: #f5f5f7;
  }
  .dark > p:not(.tags) {
    color: #a1a1a6;
  }
  .dark .tags {
    color: var(--dark-muted);
  }
  @media (max-width: 760px) {
    .tiles { grid-template-columns: 1fr; }
    .tile { min-height: 0; }
  }
</style>
