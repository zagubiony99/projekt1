---
import { getDict, type Lang } from '../i18n';
import Portrait from './Portrait.astro';
import { pageRoutes } from '../data/routes';
interface Props { lang: Lang; more?: boolean }
const t = getDict(Astro.props.lang);
const e = t.experience;
// Big sticky years: an open-ended range reads better (and fits) as "Since 2026"
const big = (when: string) => when.replace(/^(\d{4})\s*—\s*(obecnie|present)$/i, Astro.props.lang === 'pl' ? 'Od $1' : 'Since $1');
---

<section class="section" id={t.ids.experience} aria-labelledby="exp-h">
  <div class="wrap">
    <header class="head">
      <Portrait size={120} ring reveal class="me" />
      <p class="eyebrow" data-reveal>{e.label}</p>
      <h2 class="h2" id="exp-h" data-reveal>{e.title}</h2>
      <p class="lead" data-reveal style="--d:1">{e.intro}</p>
      <div class="ind" data-reveal style="--d:2">
        <p class="ind-l">{e.industriesLabel}</p>
        <ul aria-label={e.industriesLabel}>{e.industries.map((x) => <li>{x}</li>)}</ul>
      </div>
      {Astro.props.more && <a class="more about" href={pageRoutes.about[Astro.props.lang]} data-reveal style="--d:3">{e.more}</a>}
    </header>

    <div class="layout" data-exp>
      <!-- Sticky "now showing" panel: big years that change as you scroll the list -->
      <div class="aside" aria-hidden="true">
        <div class="now">
          {e.items.map((it, i) => (
            <div class:list={['slide', { on: i === 0 }]} data-slide>
              <p class="yr">{big(it.when)}</p>
              <p class="org">{it.org}</p>
            </div>
          ))}
        </div>
        <div class="dots">{e.items.map((_, i) => <i class:list={{ on: i === 0 }} data-dot />)}</div>
      </div>

      <ol class="list">
        {e.items.map((it) => (
          <li class:list={['job', { hl: 'highlight' in it && it.highlight }]} data-job data-reveal>
            <p class="when">{it.when}</p>
            <h3 class="jorg">{it.org}</h3>
            <p class="role">{it.role}</p>
            <p class="desc">{it.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .about {
    margin-top: 20px;
  }
  /* industries: quiet pill row under the intro */
  .ind {
    display: grid;
    justify-items: center;
    gap: 12px;
    margin-top: 10px;
  }
  .ind-l {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--muted);
  }
  .ind ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    max-width: 720px;
  }
  .ind li {
    padding: 7px 14px;
    border-radius: 999px;
    background: var(--gray);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .head :global(.me) {
    margin-bottom: 14px;
  }
  .layout {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }
  .aside {
    position: sticky;
    top: 30vh;
    display: grid;
    gap: 28px;
  }
  .now {
    position: relative;
    height: clamp(150px, 16vw, 210px);
  }
  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    filter: blur(8px);
    transform: translateY(24px);
    transition: opacity 0.6s var(--ease-out), transform 0.6s var(--ease-out), filter 0.6s var(--ease-out);
  }
  .slide.on {
    opacity: 1;
    filter: none;
    transform: none;
  }
  .slide.out {
    transform: translateY(-24px);
  }
  .yr {
    font-size: clamp(2.5rem, 1.2rem + 3.6vw, 4.5rem);
    white-space: nowrap;
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1;
    background: var(--ai);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-bottom: 0.08em;
    font-variant-numeric: tabular-nums;
  }
  .org {
    margin-top: 10px;
    font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .dots {
    display: flex;
    gap: 8px;
  }
  .dots i {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--gray-2);
    transition: width 0.4s var(--ease-out), background-color 0.4s;
  }
  .dots i.on {
    width: 28px;
    background: var(--ink);
  }
  .list {
    display: grid;
    gap: 16px;
  }
  .job {
    padding: 28px 30px;
    border-radius: var(--r-lg);
    background: var(--gray);
    transition: background-color 0.5s var(--ease-out), box-shadow 0.5s var(--ease-out), opacity 0.5s;
  }
  .job.is-active {
    background: var(--white);
    box-shadow: 0 20px 50px -24px rgb(0 0 0 / 0.22), inset 0 0 0 1px var(--gray-2);
  }
  .when {
    color: var(--muted);
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
  }
  .jorg {
    margin-top: 6px;
    font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.75rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .role {
    margin-top: 4px;
    font-weight: 500;
  }
  .desc {
    margin-top: 10px;
    color: var(--muted);
  }
  .hl .jorg {
    background: var(--ai);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    display: inline-block;
  }
  .hl .desc {
    color: var(--ink);
  }
  @media (max-width: 860px) {
    .layout { grid-template-columns: 1fr; }
    .aside { display: none; }
  }
</style>
