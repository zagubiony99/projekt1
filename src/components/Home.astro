---
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import Statement from './Statement.astro';
import Stage from './Stage.astro';
import Stats from './Stats.astro';
import Services from './Services.astro';
import Experience from './Experience.astro';
import Process from './Process.astro';
import Faq from './Faq.astro';
import Contact from './Contact.astro';
import CtaBand from './CtaBand.astro';
import Compare from './Compare.astro';
import StickyCta from './StickyCta.astro';
import { getDict } from '../i18n';
import Footer from './Footer.astro';
import GuideSlider from './GuideSlider.astro';
import Engage from './Engage.astro';
import { about } from '../data/pages';
import { pageRoutes } from '../data/routes';
import type { Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang);
const toContact = `#${t.ids.contact}`;
---

<Base lang={lang}>
  <Nav lang={lang} />
  <main id="main">
    <Hero lang={lang} />
    <Statement lang={lang} />
    <Stage lang={lang} />
    <Stats lang={lang} />
    <Services lang={lang} />
    <CtaBand {...t.bands.afterServices} href={toContact} />
    <Compare lang={lang} />
    <Experience lang={lang} more />
    <Process lang={lang} />
    <Engage lang={lang} />
    <Faq lang={lang} />
    <section class="section guides" aria-labelledby="hg-h">
      <GuideSlider lang={lang} eyebrow={t.nav.guides} title={about[lang].guidesTitle} lead={about[lang].guidesLead} />
      <div class="wrap wrap--wide">
        <p class="all" data-reveal><a class="more" href={pageRoutes.guides[lang]}>{t.guidesUi.all}</a></p>
      </div>
    </section>
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
  <StickyCta lang={lang} />
</Base>

<script>
  import '../scripts/main.ts';
</script>

<style>
  .all {
    margin-top: 28px;
    text-align: center;
  }
</style>
