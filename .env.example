# Skopiuj do .env i wstaw prawdziwy token.
# .env jest w .gitignore — token NIGDY nie trafia do repo ani do logów.
ONCRAWL_TOKEN=your_token_here

# Opcjonalne — mają sensowne domyślne wartości, zwykle nie trzeba zmieniać.
# ONCRAWL_BASE_URL=https://app.oncrawl.com/api/v2
# ONCRAWL_CACHE_DIR=.cache
# ONCRAWL_TIMEOUT=30
# ONCRAWL_MAX_RETRIES=5
# ONCRAWL_CONCURRENCY=4
