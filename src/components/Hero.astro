---
import { getDict, type Lang } from '../i18n';
interface Props { lang: Lang }
const t = getDict(Astro.props.lang);
const h = t.hero;
const c = h.card;
---

<section class="hero" id="top">
  <div class="wrap top">
    <p class="eyebrow">{h.pill}</p>
    <h1>
      <span>{h.titleA}</span>
      <span class="b">{h.titleB}</span>
    </h1>
    <p class="lead">{h.lead}</p>
    <div class="ctas">
      <a class="btn" href="#kontakt">{h.ctaPrimary}</a>
      <a class="more" href="#doswiadczenie">{h.ctaSecondary}</a>
    </div>
  </div>

  <div class="wrap">
    <div class="stage" data-stage>
      <figure class="card" data-bots aria-label={c.title}>
        <figcaption class="card__head">
          <span class="card__title">{c.title}</span>
          <span class="card__note">{c.note}</span>
        </figcaption>
        <div class="url">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 11V8a5 5 0 0 1 10 0v3M5 11h14v10H5z" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" /></svg>
          {c.url}
        </div>
        <ul class="rows">
          {c.rows.map((r) => (
            <li class="row" data-s={r.s}>
              <span class="bot">{r.bot}</span>
              <span class="res">
                <i class="ind" aria-hidden="true">
                  {r.s === 'ok' ? (
                    <svg viewBox="0 0 16 16"><path d="m4.5 8.2 2.3 2.3 4.7-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  ) : r.s === 'warn' ? (
                    <svg viewBox="0 0 16 16"><path d="M8 4.5v4.2M8 11.2v.3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                  ) : (
                    <svg viewBox="0 0 16 16"><path d="m5.2 5.2 5.6 5.6m0-5.6-5.6 5.6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                  )}
                </i>
                <span>{r.t}</span>
              </span>
            </li>
          ))}
        </ul>
        <p class="sum" data-sum>{c.summary}</p>
      </figure>
    </div>

    <dl class="stats" aria-label={t.stats.label}>
      {t.stats.items.map((s, i) => (
        <div data-reveal style={`--d:${i}`}>
          <dt>{s.k}</dt>
          <dd>{s.v}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(112px, 12vw, 160px);
    padding-bottom: clamp(72px, 9vw, 128px);
  }
  .top {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 20px;
  }
  h1 {
    display: grid;
    font-size: clamp(3rem, 1.2rem + 6.4vw, 6.75rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
    font-weight: 800;
    color: var(--forest);
  }
  h1 .b {
    background: linear-gradient(90deg, #2f6b0a, #5fae2c 55%, #3d8a12);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-bottom: 0.06em;
  }
  .top .lead {
    max-width: 40ch;
    margin-top: 4px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 14px 28px;
    margin-top: 12px;
  }

  /* ---------- Stage: the audit card shown like a product ---------- */
  .stage {
    --k: 0;
    margin-top: clamp(56px, 7vw, 96px);
    padding: clamp(28px, 6vw, 88px) clamp(16px, 6vw, 88px);
    border-radius: var(--r-lg);
    background:
      radial-gradient(60% 70% at 50% 0%, rgb(159 232 112 / 0.35), transparent 70%),
      var(--gray);
    display: grid;
    place-items: center;
    transform: scale(calc(0.94 + var(--k) * 0.06));
    transform-origin: 50% 0;
  }
  .card {
    width: min(100%, 640px);
    padding: clamp(18px, 2.4vw, 28px);
    border-radius: 22px;
    background: var(--white);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.04),
      0 24px 60px -20px rgb(22 51 0 / 0.25);
  }
  .card__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }
  .card__title {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .card__note {
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
  .url {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    padding: 10px 14px;
    border-radius: 12px;
    background: var(--gray);
    color: var(--ink-2);
    font-size: 0.875rem;
  }
  .rows {
    margin-top: 6px;
  }
  .row {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    gap: 12px;
    align-items: center;
    padding: 13px 2px;
    border-bottom: 1px solid var(--line);
    font-size: 0.9375rem;
  }
  .row:last-child {
    border-bottom: 0;
  }
  .bot {
    font-weight: 650;
  }
  .res {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink-2);
    min-width: 0;
  }
  .res > span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ind {
    flex: none;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--green);
    color: var(--forest);
  }
  .ind svg {
    width: 14px;
    height: 14px;
  }
  [data-s='warn'] .ind { background: #ffe7b3; color: var(--amber); }
  [data-s='err'] .ind { background: #ffd9d4; color: var(--red); }
  .sum {
    margin-top: 14px;
    padding: 14px 16px;
    border-radius: 14px;
    background: var(--forest);
    color: var(--green);
    font-weight: 600;
    font-size: 0.9375rem;
    text-align: center;
  }

  /* Scan animation (JS only): each row resolves in turn. */
  .js .row .res {
    opacity: 0.2;
    transition: opacity 0.45s var(--ease);
  }
  .js .row .ind {
    background: var(--gray-2);
    color: transparent;
    transition: background-color 0.3s, color 0.3s, transform 0.4s var(--ease-out);
    transform: scale(0.7);
  }
  .js .row.is-done .res { opacity: 1; }
  .js .row.is-done .ind { transform: none; background: var(--green); color: var(--forest); }
  .js .row.is-done[data-s='warn'] .ind { background: #ffe7b3; color: var(--amber); }
  .js .row.is-done[data-s='err'] .ind { background: #ffd9d4; color: var(--red); }
  .js .sum {
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.6s var(--ease-out), transform 0.6s var(--ease-out);
  }
  .js .sum.is-done {
    opacity: 1;
    transform: none;
  }

  /* ---------- Stats ---------- */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
    margin-top: clamp(64px, 8vw, 104px);
    text-align: center;
  }
  .stats div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 6px;
  }
  .stats dd {
    font-size: clamp(2.5rem, 1.6rem + 2.6vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--forest);
  }
  .stats dt {
    color: var(--ink-3);
    font-size: 0.9375rem;
    line-height: 1.4;
    max-width: 22ch;
    margin-inline: auto;
  }

  .js .top > * {
    animation: up 1.1s var(--ease-out) both;
  }
  .js .top > :nth-child(2) { animation-delay: 0.08s; }
  .js .top > :nth-child(3) { animation-delay: 0.16s; }
  .js .top > :nth-child(4) { animation-delay: 0.24s; }
  @keyframes up {
    from { opacity: 0; transform: translateY(24px); }
  }

  @media (max-width: 900px) {
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 40px; }
  }
  @media (max-width: 520px) {
    .row { grid-template-columns: 1fr; gap: 6px; }
    .ctas .btn { width: 100%; }
  }
</style>
