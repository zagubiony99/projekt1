---
import { getDict, type Lang } from '../i18n';
interface Props { lang: Lang }
const t = getDict(Astro.props.lang);
const c = t.compare;
const rows = c.rows.length;
---

<!-- Two "models" side by side, Apple compare-page style. Rows line up across both cards (subgrid). -->
<section class="section section--gray" aria-labelledby="cmp-h">
  <div class="wrap">
    <header class="head">
      <p class="eyebrow" data-reveal>{c.label}</p>
      <h2 class="h2" id="cmp-h" data-reveal>{c.title}</h2>
    </header>

    <div class="duo" style={`--rows:${rows}`}>
      <article class="card me" data-reveal aria-labelledby="cmp-me">
        <header class="top">
          <h3 id="cmp-me" class="ai">{c.me}</h3>
          <p class="sub">{t.hero.pill}</p>
        </header>
        {c.rows.map((r, i) => (
          <div class="item" style={`--i:${i}`}>
            <i class="mk y" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="m4.5 8.2 2.3 2.3 4.7-5" /></svg></i>
            <p><span class="k">{r.k}</span><span class="v">{r.me}</span><span class="alt">{c.them}: {r.them}</span></p>
          </div>
        ))}
        <div class="foot">
          <a class="btn" href={`#${t.ids.contact}`} data-magnet>{t.hero.ctaPrimary}</a>
        </div>
      </article>

      <article class="card them" data-reveal style="--d:1" aria-labelledby="cmp-them">
        <header class="top">
          <h3 id="cmp-them">{c.them}</h3>
        </header>
        {c.rows.map((r) => (
          <div class="item">
            <i class="mk n" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M5 8h6" /></svg></i>
            <p><span class="k">{r.k}</span><span class="v">{r.them}</span></p>
          </div>
        ))}
        <div class="foot"></div>
      </article>
    </div>
  </div>
</section>

<style>
  .duo {
    display: grid;
    grid-template-columns: 1.08fr 1fr;
    /* header, one row per comparison point, footer */
    grid-template-rows: auto repeat(var(--rows), auto) auto;
    gap: 0 clamp(16px, 2.4vw, 28px);
    max-width: 1080px;
    margin-inline: auto;
    align-items: start;
  }
  .card {
    grid-row: 1 / -1;
    display: grid;
    grid-template-rows: subgrid;
    border-radius: var(--r-lg);
    padding: clamp(24px, 3.4vw, 44px);
    padding-top: clamp(28px, 3.8vw, 48px);
  }
  .me {
    background: #000;
    color: #f5f5f7;
    box-shadow: 0 40px 90px -40px rgb(40 20 90 / 0.55);
    position: relative;
    overflow: hidden;
  }
  /* soft colour aura in the corner of the featured card */
  .me::before {
    content: '';
    position: absolute;
    inset: -40% -30% auto auto;
    width: 80%;
    aspect-ratio: 1;
    background: radial-gradient(closest-side, rgb(201 89 221 / 0.28), transparent);
    pointer-events: none;
  }
  .them {
    background: var(--white);
    color: var(--ink);
  }
  .top {
    padding-bottom: 22px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 6px;
  }
  .me .top {
    border-color: rgb(255 255 255 / 0.12);
  }
  h3 {
    font-size: clamp(2rem, 1.5rem + 1.8vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    font-weight: 700;
    width: fit-content;
    padding-bottom: 0.06em;
  }
  .them h3 {
    color: var(--muted);
  }
  .sub {
    margin-top: 8px;
    color: var(--dark-muted);
    font-size: 0.9375rem;
  }
  .item {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 14px;
    align-items: start;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .me .item {
    border-color: rgb(255 255 255 / 0.1);
  }
  .item:nth-last-child(2) {
    border-bottom: 0;
  }
  .k {
    display: block;
    margin-bottom: 3px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--muted);
  }
  .me .k {
    color: var(--dark-muted);
  }
  .v {
    display: block;
    font-size: clamp(1rem, 0.96rem + 0.2vw, 1.125rem);
    line-height: 1.4;
    letter-spacing: -0.012em;
  }
  .me .v {
    font-weight: 500;
  }
  .them .v {
    color: var(--muted);
  }
  .mk {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    margin-top: 12px;
    border-radius: 50%;
  }
  .mk svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .y { background: #30d158; color: #000; }
  .n { background: var(--gray-2); color: var(--muted); }
  .alt {
    display: none;
  }
  .foot {
    padding-top: 22px;
  }
  .foot .btn {
    width: 100%;
  }

  /* checks pop in one after another once the card is revealed */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .me .y {
      transform: scale(0);
      transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
      transition-delay: calc(0.45s + var(--i) * 0.09s);
    }
    :global(.js) .me.is-in .y {
      transform: none;
    }
  }

  @media (max-width: 820px) {
    .duo {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      gap: 16px;
    }
    .card {
      grid-row: auto;
      display: block;
    }
    /* phones: one card; the agency answer sits under each point instead of a second tall card */
    .them {
      display: none;
    }
    .alt {
      display: block;
      margin-top: 6px;
      font-size: 0.875rem;
      line-height: 1.4;
      color: var(--dark-muted);
    }
  }
</style>
