---
import { getDict, type Lang } from '../i18n';
interface Props { lang: Lang }
const t = getDict(Astro.props.lang);
const f = t.faq;
---

<section class="section dark faq" id="faq" aria-labelledby="faq-h">
  <div class="wrap grid">
    <header class="head">
      <p class="pill">{f.label}</p>
      <h2 class="h2" id="faq-h">{f.title}</h2>
    </header>
    <div class="items">
      {f.items.map((it, i) => (
        <details class="q" name="faq" open={i === 0} data-reveal style={`--d:${i % 3}`}>
          <summary>
            <span class="qt">{it.q}</span>
            <span class="pm" aria-hidden="true"></span>
          </summary>
          <p class="a">{it.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }
  .head {
    position: sticky;
    top: 120px;
    display: grid;
    gap: 24px;
    justify-items: start;
  }
  .head .h2 {
    font-size: clamp(2.75rem, 1.6rem + 3.6vw, 5.5rem);
  }
  .items {
    display: grid;
    gap: 10px;
  }
  .q {
    border-radius: var(--r);
    background: var(--forest-2);
    transition: background-color 0.3s;
  }
  .q:hover {
    background: #1b4337;
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 24px 24px 24px 28px;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  .qt {
    font-size: clamp(1.25rem, 1rem + 0.9vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }
  .pm {
    position: relative;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--lime);
    transition: transform 0.45s var(--spring), background-color 0.3s;
  }
  .pm::before,
  .pm::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 16px;
    height: 2.5px;
    border-radius: 2px;
    background: var(--forest);
    translate: -50% -50%;
  }
  .pm::after { rotate: 90deg; }
  .q[open] .pm {
    transform: rotate(135deg);
    background: var(--coral);
  }
  .a {
    padding: 0 28px 28px;
    max-width: 60ch;
    color: var(--mist);
    font-size: 1.0625rem;
    line-height: 1.6;
  }
  .q[open] .a { animation: open 0.5s var(--ease); }
  @keyframes open {
    from { opacity: 0; transform: translateY(-8px); }
  }
  @media (max-width: 960px) {
    .grid { grid-template-columns: 1fr; }
    .head { position: static; }
  }
</style>
