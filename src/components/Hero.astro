---
import { getDict, type Lang } from '../i18n';
interface Props { lang: Lang }
const t = getDict(Astro.props.lang);
const h = t.hero;
---

<section class="hero dark" id="top">
  <div class="wrap">
    <p class="pill top-pill">{h.pill}</p>

    <h1 class="title">
      {h.title.map((p) => ('hl' in p && p.hl ? <span class="hl">{p.t}</span> : p.t))}
    </h1>

    <div class="sticker" aria-hidden="true">
      <span>{h.sticker.map((l) => <b>{l}</b>)}</span>
    </div>

    <div class="row">
      <div class="left">
        <div class="ctas">
          <a class="btn" href="#kontakt">{h.ctaPrimary} <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn--ghost" href="#uslugi">{h.ctaSecondary}</a>
        </div>
        <p class="lead">{h.lead}</p>
      </div>
      <ul class="chips" aria-label={t.services.title}>
        {t.services.items.map((s) => <li class="chip">{s.name}</li>)}
      </ul>
    </div>
  </div>
  <svg class="squiggle" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 60 C 120 10, 240 110, 360 60 S 600 10, 720 60 S 960 110, 1080 60 S 1320 10, 1440 60 V120 H0 Z" />
  </svg>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(120px, 12vw, 168px);
    padding-bottom: clamp(96px, 9vw, 150px);
    overflow: hidden;
  }
  .hero .wrap {
    position: relative;
  }
  .top-pill {
    color: var(--cream);
  }
  .title {
    margin-top: clamp(20px, 2.4vw, 32px);
    max-width: 11.5em;
    font-size: clamp(3.4rem, 1rem + 8.6vw, 10rem);
    line-height: 0.9;
    letter-spacing: -0.055em;
    font-weight: 790;
    text-wrap: balance;
  }
  .title .hl {
    margin-block: 0.04em;
  }
  .sticker {
    position: absolute;
    right: var(--gutter);
    top: clamp(-10px, 1vw, 20px);
    width: clamp(120px, 13vw, 196px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--coral);
    color: var(--forest);
    display: grid;
    place-items: center;
    animation: wobble 6s ease-in-out infinite;
  }
  .sticker span {
    display: grid;
    text-align: center;
    font-size: clamp(1.05rem, 0.6rem + 1vw, 1.5rem);
    line-height: 1;
    font-weight: 780;
    letter-spacing: -0.02em;
  }
  @keyframes wobble {
    0%, 100% { transform: rotate(12deg); }
    50% { transform: rotate(-6deg) scale(1.04); }
  }
  .row {
    margin-top: clamp(48px, 6vw, 96px);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 48px;
  }
  .left {
    display: grid;
    gap: 36px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .lead {
    color: var(--mist);
    max-width: 34ch;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 10px;
    max-width: 520px;
    color: rgb(244 239 227 / 0.88);
  }
  .chips .chip {
    border-color: rgb(244 239 227 / 0.3);
  }
  .squiggle {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    width: 100%;
    height: clamp(36px, 5vw, 72px);
    fill: var(--lime);
  }

  .js .title,
  .js .row,
  .js .top-pill {
    animation: up 1s var(--ease) both;
  }
  .js .title { animation-delay: 0.08s; }
  .js .row { animation-delay: 0.22s; }
  .js .sticker {
    animation: pop 0.9s var(--spring) 0.4s both, wobble 6s ease-in-out 1.3s infinite;
  }
  @keyframes up {
    from { opacity: 0; transform: translateY(36px); }
  }
  @keyframes pop {
    from { opacity: 0; transform: scale(0.3) rotate(-40deg); }
    to { transform: rotate(12deg); }
  }

  @media (max-width: 1060px) {
    .row { flex-direction: column; align-items: flex-start; }
    .chips { justify-content: flex-start; }
  }
  @media (max-width: 720px) {
    .title { font-size: 15vw; }
    .chips { display: none; }
    .sticker { top: auto; bottom: -84px; right: var(--gutter); width: 104px; }
    .row { margin-top: 40px; }
    .ctas .btn { flex: 1 1 auto; justify-content: center; }
  }
</style>
