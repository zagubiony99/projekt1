---
import { getDict, type Lang } from '../i18n';
interface Props { lang: Lang }
const t = getDict(Astro.props.lang);
---

<section class="section stats-sec" aria-label={t.stats.label}>
  <div class="wrap wrap--wide">
    <dl class="stats">
      {t.stats.items.map((s, i) => (
        <div data-reveal style={`--d:${i}`}>
          <dt>{s.k}</dt>
          <dd data-count>{s.v}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 40px 32px;
    text-align: center;
  }
  .stats div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 10px;
  }
  dd {
    font-size: clamp(3rem, 2rem + 3vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  dt {
    color: var(--muted);
    font-size: 1.0625rem;
    line-height: 1.35;
    max-width: 22ch;
    margin-inline: auto;
  }
  dd { white-space: nowrap; }
  @media (max-width: 860px) {
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 520px) {
    .stats { gap: 36px 16px; }
    dd { font-size: clamp(2rem, 9.5vw, 2.75rem); }
    dt { font-size: 0.9375rem; }
  }
</style>
