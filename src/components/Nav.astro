---
import { getDict, otherLang, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang);
const alt = getDict(otherLang(lang));
const links = [
  ['#uslugi', t.nav.services],
  ['#doswiadczenie', t.nav.experience],
  ['#proces', t.nav.process],
  ['#faq', t.nav.faq],
] as const;
---

<header class="nav" data-nav>
  <div class="wrap bar">
    <a class="logo" href={t.path} aria-label="Maciej Zięciak — home">
      <span class="mark" aria-hidden="true">MZ</span>
      <span>Maciej Zięciak</span>
    </a>

    <nav class="links" aria-label="Main">
      {links.map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>

    <div class="end">
      <a class="lang" href={alt.path} hreflang={alt.lang} aria-label={t.nav.switchLabel}>
        <span class:list={{ on: lang === 'pl' }}>PL</span>
        <span class:list={{ on: lang === 'en' }}>EN</span>
      </a>
      <a class="btn cta" href="#kontakt">{t.nav.cta}</a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="mobile-menu" data-burger>
        <span class="sr-only" data-burger-label data-open={t.nav.menu} data-close={t.nav.close}>{t.nav.menu}</span>
        <i></i><i></i>
      </button>
    </div>
  </div>

  <div class="sheet" id="mobile-menu" data-sheet hidden>
    <nav class="wrap sheet__in" aria-label="Mobile">
      {[...links, ['#kontakt', t.nav.contact]].map(([href, label]) => <a href={href}>{label}</a>)}
      <a class="btn btn--ghost" href={alt.path} hreflang={alt.lang}>{t.nav.switchLabel}</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition: background-color 0.3s, border-color 0.3s;
  }
  .nav.is-scrolled,
  .nav:has([aria-expanded='true']) {
    background: rgb(10 11 10 / 0.8);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    border-bottom-color: var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 72px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .mark {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: var(--accent);
    color: var(--bg);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .links {
    display: flex;
    gap: 4px;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .links a {
    padding: 8px 14px;
    border-radius: 999px;
    transition: color 0.2s, background-color 0.2s;
  }
  .links a:hover {
    color: var(--text);
    background: var(--bg-3);
  }
  .end {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .lang {
    display: inline-flex;
    padding: 3px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line-2);
    font-size: 0.75rem;
    font-weight: 600;
  }
  .lang span {
    padding: 5px 9px;
    border-radius: 999px;
    color: var(--dim);
    transition: color 0.2s;
  }
  .lang:hover span {
    color: var(--muted);
  }
  .lang .on,
  .lang:hover .on {
    background: var(--bg-3);
    color: var(--text);
  }
  .cta {
    min-height: 40px;
    padding: 0 18px;
    font-size: 0.875rem;
  }
  .burger {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line-2);
  }
  .burger i {
    position: absolute;
    left: 14px;
    right: 14px;
    height: 1.5px;
    background: var(--text);
    transition: transform 0.3s var(--ease);
  }
  .burger i:first-of-type { top: 18px; }
  .burger i:last-of-type { top: 25px; }
  .burger[aria-expanded='true'] i:first-of-type { transform: translateY(3.5px) rotate(45deg); }
  .burger[aria-expanded='true'] i:last-of-type { transform: translateY(-3.5px) rotate(-45deg); }

  .sheet {
    position: fixed;
    inset: 72px 0 0;
    background: var(--bg);
    overflow: auto;
  }
  .sheet__in {
    display: grid;
    padding-block: 16px 40px;
  }
  .sheet__in a:not(.btn) {
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    font-size: 1.75rem;
    font-weight: 560;
    letter-spacing: -0.03em;
  }
  .sheet__in .btn {
    justify-self: start;
    margin-top: 28px;
  }

  @media (max-width: 980px) {
    .links { display: none; }
  }
  @media (max-width: 640px) {
    .cta, .end > .lang { display: none; }
    .burger { display: block; }
  }
</style>
