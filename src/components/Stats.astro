---
import { getDict, type Lang } from '../i18n';
interface Props { lang: Lang }
const t = getDict(Astro.props.lang);
---

<section class="section stats-sec" aria-label={t.stats.label}>
  <div class="wrap wrap--wide">
    <dl class="stats">
      {t.stats.items.map((s, i) => (
        <div data-reveal style={`--d:${i}`}>
          <dt>{s.k}</dt>
          <dd data-count>{s.v}</dd>
        </div>
      ))}
    </dl>
    <div class="tools" data-reveal>
      <p>{t.tools.label}</p>
      <div class="marquee">
        {[0, 1].map((k) => (
          <ul aria-hidden={k === 1 ? 'true' : undefined}>
            {[...t.tools.items, ...t.tools.items].map((n) => <li>{n}</li>)}
          </ul>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 40px 32px;
    text-align: center;
  }
  .stats div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 10px;
  }
  dd {
    font-size: clamp(3rem, 2rem + 3vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  dt {
    color: var(--muted);
    font-size: 1.0625rem;
    line-height: 1.35;
    max-width: 22ch;
    margin-inline: auto;
  }
  dd { white-space: nowrap; }
  .tools {
    margin-top: clamp(72px, 9vw, 120px);
    padding-top: 40px;
    border-top: 1px solid var(--line);
    text-align: center;
  }
  .tools p {
    color: var(--muted);
    font-size: 1.0625rem;
  }
  .marquee {
    display: flex;
    overflow: hidden;
    margin-top: 26px;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .marquee ul {
    flex: none;
    display: flex;
    gap: clamp(40px, 6vw, 88px);
    padding-right: clamp(40px, 6vw, 88px);
    animation: slide 30s linear infinite;
  }
  .marquee:hover ul {
    animation-play-state: paused;
  }
  @keyframes slide {
    to { transform: translateX(-100%); }
  }
  .tools li {
    white-space: nowrap;
    font-size: clamp(1.375rem, 1.1rem + 1vw, 2rem);
    font-weight: 650;
    letter-spacing: -0.035em;
    color: #86868b;
    transition: color 0.3s;
  }
  .tools li:hover {
    color: var(--ink);
  }
  @media (max-width: 860px) {
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 520px) {
    .stats { gap: 36px 16px; }
    dd { font-size: clamp(2rem, 9.5vw, 2.75rem); }
    dt { font-size: 0.9375rem; }
  }
</style>
