---
import { getDict, type Lang } from '../i18n';
import { services as pages, ui } from '../data/services';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang);
const s = t.services;
const pl = lang === 'pl';
// Small strings used inside the illustrations
const v = {
  q: pl ? 'Jakiego konsultanta SEO wybrać do dużego serwisu?' : 'Who is a good technical SEO consultant?',
  a: pl ? 'Najlepiej kogoś z doświadczeniem w dużych serwisach i AI search, np.' : 'Consider specialists with large-site and AI search experience, e.g.',
  indexed: pl ? 'zaindeksowane' : 'indexed',
  richUrl: pl ? 'twojsklep.pl › buty › bieganie' : 'yourstore.com › shoes › running',
  richTitle: pl ? 'Buty do biegania Pegasus 41 – damskie' : 'Pegasus 41 running shoes – women’s',
  richReviews: pl ? '127 opinii' : '127 reviews',
  richStock: pl ? 'Dostępny' : 'In stock',
  blocked: pl ? 'zatrzymane' : 'blocked',
  hub: pl ? 'Buty do biegania' : 'Running shoes',
  topics: pl
    ? ['Na maraton', 'Dla początkujących', 'Rozmiary', 'Trail', 'Amortyzacja', 'Ranking 2026']
    : ['For a marathon', 'For beginners', 'Sizing', 'Trail', 'Cushioning', 'Best of 2026'],
  noindex: 'noindex',
  // ChatGPT app (MCP): a question, the tool call, live results from the company's system
  mcpQ: pl ? 'Pokaż mieszkania w Krakowie do 600 tys.' : 'Show me flats in Kraków under 600k PLN',
  mcpArgs: pl ? 'miasto: "Kraków", max: 600000' : 'city: "Kraków", max: 600000',
  mcpRows: pl
    ? [['2 pokoje · 48 m² · Podgórze', '589 000 zł'], ['3 pokoje · 61 m² · Krowodrza', '598 000 zł']]
    : [['2 rooms · 48 m² · Podgórze', '589,000 zł'], ['3 rooms · 61 m² · Krowodrza', '598,000 zł']],
};
const nodes = [[50, 22], [24, 46], [76, 46], [12, 74], [38, 74], [62, 74], [88, 74]];
const edges = [[0, 1], [0, 2], [1, 3], [1, 4], [2, 5], [2, 6]];
const redirects = [
  ['/sklep/buty-damskie', '/kobiety/buty'],
  ['/produkt.php?id=812', '/buty/sneaker-air'],
  ['/oferta/seo', '/uslugi/technical-seo'],
];
const schemaTypes = ['Product', 'Offer', 'AggregateRating'];
const pipeline: [string, string][] = pl
  ? [['Build i testy', 'ok'], ['SEO: canonical, hreflang', 'ok'], ['SEO: noindex na /kategorie/', 'stop'], ['Wdrożenie', 'wait']]
  : [['Build & tests', 'ok'], ['SEO: canonical, hreflang', 'ok'], ['SEO: noindex on /categories/', 'stop'], ['Deploy', 'wait']];
// six topics around the hub (x, y in %)
const topicPos = [[20, 12], [80, 12], [10, 50], [90, 50], [20, 88], [80, 88]];
const hreflang = [['pl-PL', '/pl/'], ['en-GB', '/en/'], ['de-DE', '/de/'], ['cs-CZ', '/cz/'], ['x-default', '/']];
---

<section class="section section--gray svc" id={t.ids.services} aria-labelledby="uslugi-h">

  <div class="hs" data-hscroll>
    <div class="hs__sticky">
    <div class="wrap">
      <header class="head">
        <p class="eyebrow" data-reveal>{s.label}</p>
        <h2 class="h2" id="uslugi-h" data-reveal>{s.title}</h2>
        <p class="lead" data-reveal style="--d:1">{s.intro}</p>
      </header>
    </div>
      <ul class="track" data-track>
        {pages.map((p) => ({ key: p.key, slug: p[lang].slug, name: p[lang].name, ...p[lang].card })).map((it) => (
          <li class:list={['card', `v-${it.key}`, { dark: it.key === 'ai' }]} data-card data-tilt>
            <div class="vis" aria-hidden="true">
              {it.key === 'audit' && (
                <svg viewBox="0 0 100 90" class="crawl">
                  {edges.map(([a, b], k) => <line x1={nodes[a][0]} y1={nodes[a][1]} x2={nodes[b][0]} y2={nodes[b][1]} style={`--k:${k}`} />)}
                  {nodes.map(([x, y], k) => <circle cx={x} cy={y} r="5.5" style={`--k:${k}`} />)}
                </svg>
              )}
              {it.key === 'ai' && (
                <div class="chat">
                  <p class="bubble q">{v.q}</p>
                  <p class="bubble a">{v.a} <span class="cite">maciejzieciak.com</span></p>
                </div>
              )}
              {it.key === 'mcp' && (
                <div class="mcpv">
                  <p class="bubble q">{v.mcpQ}</p>
                  <p class="call"><span class="fn">search_offers</span>(<span class="val">{v.mcpArgs}</span>)</p>
                  <ul class="app">
                    {v.mcpRows.map(([n, pz], k) => <li style={`--k:${k}`}><i></i><span>{n}</span><b>{pz}</b></li>)}
                  </ul>
                </div>
              )}
              {it.key === 'large' && (
                <div class="pages">
                  {Array.from({ length: 72 }).map((_, k) => <i style={`--k:${(k * 37) % 72}`} class:list={{ off: k % 11 === 7 }} />)}
                  <span class="legend"><b></b>{v.indexed}<b class="o"></b>{v.noindex}</span>
                </div>
              )}
              {it.key === 'intl' && (
                <ul class="code">
                  {hreflang.map(([l, h], k) => (
                    <li style={`--k:${k}`}><span class="tag">&lt;link</span> <span class="attr">hreflang</span>="<span class="val">{l}</span>" <span class="attr">href</span>="<span class="val">{h}</span>"&gt; <span class="ok">✓</span></li>
                  ))}
                </ul>
              )}
              {it.key === 'migration' && (
                <ul class="redir">
                  {redirects.map(([a, b], k) => (
                    <li style={`--k:${k}`}><span class="old">{a}</span><span class="badge">301</span><span class="new">{b}</span></li>
                  ))}
                </ul>
              )}
              {it.key === 'schema' && (
                <div class="rich">
                  <p class="r-url">{v.richUrl}</p>
                  <p class="r-title">{v.richTitle}</p>
                  <p class="r-meta"><span class="stars">★★★★★</span> 4,8 · {v.richReviews} · <b>349 zł</b> · <span class="instock">{v.richStock}</span></p>
                  <ul class="r-ld">
                    {schemaTypes.map((ty, k) => <li style={`--k:${k}`}><span class="attr">"@type"</span>: <span class="val">"{ty}"</span> <span class="ok">✓</span></li>)}
                  </ul>
                </div>
              )}
              {it.key === 'webops' && (
                <ul class="pipe">
                  {pipeline.map(([label, st], k) => (
                    <li class={`s-${st}`} style={`--k:${k}`}><i aria-hidden="true"></i><span>{label}</span><b>{st === 'ok' ? '✓' : st === 'stop' ? v.blocked : ''}</b></li>
                  ))}
                </ul>
              )}
              {it.key === 'content' && (
                <div class="cluster">
                  <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                    {topicPos.map(([x, y], k) => <line x1="50" y1="50" x2={x} y2={y} style={`--k:${k}`} />)}
                  </svg>
                  <span class="hub">{v.hub}</span>
                  {v.topics.map((tp, k) => <span class="tp" style={`--k:${k};left:${topicPos[k][0]}%;top:${topicPos[k][1]}%`}>{tp}</span>)}
                </div>
              )}
              {it.key === 'ecom' && (
                <div class="shop">
                  <div class="facets"><span class="on">Sneakers</span><span>42</span><span class="x">?color=&amp;sort=</span></div>
                  <div class="grid">{Array.from({ length: 6 }).map((_, k) => <i style={`--k:${k}`} />)}</div>
                </div>
              )}
            </div>
            <div class="txt">
              <h3 class:list={{ ai: it.key === 'ai' }} data-vt-title>{it.name}</h3>
              <p>{it.desc}</p>
              <p class="tags">{it.tags.join(' · ')}</p>
              <a class="more go" href={`${ui[lang].base}${it.slug}/`}>{ui[lang].more}<span class="sr-only">: {it.name}</span></a>
            </div>
          </li>
        ))}
      </ul>
      <div class="bar" aria-hidden="true"><i data-hbar></i></div>
    </div>
  </div>
</section>

<style>
  .svc {
    padding-block: 0;
  }
  .svc .head {
    margin-bottom: 0;
    gap: 8px;
  }
  .svc .h2 {
    font-size: clamp(2.25rem, 1.5rem + 2.6vw, 3.75rem);
  }
  .svc .lead {
    font-size: clamp(1rem, 0.95rem + 0.35vw, 1.25rem);
    max-width: 60ch;
  }
  /* Pinned horizontal gallery: vertical scroll drives the track sideways */
  .hs {
    --x: 0px;
    position: relative;
  }
  .hs__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    gap: clamp(16px, 3vh, 32px);
    padding-top: 52px;
    overflow: hidden;
  }
  .track {
    width: max-content;
    display: flex;
    gap: 24px;
    padding-inline: max(var(--gutter), calc((100vw - var(--max-wide)) / 2));
    transform: translate3d(var(--x), 0, 0);
    will-change: transform;
  }
  .card {
    --mx: 50%;
    --my: 50%;
    --rx: 0deg;
    --ry: 0deg;
    position: relative;
    flex: none;
    width: min(440px, 82vw);
    height: min(540px, 58vh);
    display: grid;
    grid-template-rows: 1fr auto;
    border-radius: var(--r-lg);
    background: var(--white);
    overflow: hidden;
    isolation: isolate;
    transform: perspective(1200px) rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform 0.5s var(--ease-out), box-shadow 0.6s var(--ease-out);
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(420px circle at var(--mx) var(--my), rgb(0 113 227 / 0.08), transparent 60%);
    opacity: 0;
    transition: opacity 0.4s;
  }
  .card:hover::before { opacity: 1; }
  .card:hover { box-shadow: 0 30px 60px -28px rgb(0 0 0 / 0.25); }
  .dark { background: var(--black); color: #f5f5f7; }
  .dark::before { background: radial-gradient(460px circle at var(--mx) var(--my), color-mix(in srgb, var(--a2) 28%, transparent), color-mix(in srgb, var(--a1) 10%, transparent) 40%, transparent 65%); }
  .txt {
    display: grid;
    gap: 10px;
    padding: 0 32px 32px;
  }
  h3 {
    width: fit-content;
    font-size: clamp(1.625rem, 1.3rem + 1vw, 2.125rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
    font-weight: 650;
  }
  .txt > p:not(.tags) {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.45;
  }
  .dark .txt > p:not(.tags) { color: #a1a1a6; }
  .tags { font-size: 0.8125rem; color: var(--muted); }
  .go { margin-top: 4px; font-size: 1rem; }
  .dark .go { color: var(--link-dark); }
  /* whole card is clickable via the link's stretched hit area */
  .go::before { content: ''; position: absolute; inset: 0; z-index: 1; }
  .card { cursor: pointer; }
  .bar {
    width: min(220px, 40vw);
    height: 4px;
    margin-inline: auto;
    border-radius: 4px;
    background: var(--gray-2);
    overflow: hidden;
  }
  .bar i {
    display: block;
    height: 100%;
    width: 100%;
    border-radius: 4px;
    background: var(--ink);
    transform-origin: 0 50%;
    transform: scaleX(var(--hp, 0.1));
  }

  /* ---------- Illustrations ---------- */
  .vis {
    position: relative;
    display: grid;
    place-items: center;
    padding: 28px 28px 8px;
    overflow: hidden;
  }
  /* 0: crawl graph — nodes light up as the crawler walks the tree */
  .crawl { width: 78%; overflow: visible; }
  .crawl line { stroke: var(--gray-2); stroke-width: 1.4; }
  .crawl circle { fill: var(--gray-2); }
  .card.is-on .crawl line { stroke: #0071e3; stroke-dasharray: 60; stroke-dashoffset: 60; animation: draw 0.6s var(--ease-out) forwards; animation-delay: calc(0.3s + var(--k) * 0.22s); }
  .card.is-on .crawl circle { animation: ping 0.5s var(--ease-out) forwards; animation-delay: calc(0.15s + var(--k) * 0.22s); }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes ping { 50% { r: 8; } to { fill: #0071e3; r: 5.5; } }

  /* 1: AI answer citing the site */
  .chat { display: grid; gap: 12px; width: 100%; max-width: 340px; }
  .bubble { padding: 12px 16px; border-radius: 18px; font-size: 0.875rem; line-height: 1.4; opacity: 0; transform: translateY(14px); }
  .q { justify-self: end; background: #0071e3; color: #fff; border-bottom-right-radius: 6px; }
  .a { background: #1d1d1f; color: #e8e8ed; border-bottom-left-radius: 6px; }
  .cite { display: inline-block; margin-top: 6px; padding: 3px 10px; border-radius: 999px; background: var(--ai); color: #fff; font-weight: 600; font-size: 0.8125rem; box-shadow: 0 0 24px color-mix(in srgb, var(--a2) 60%, transparent); }
  .card.is-on .bubble { animation: pop 0.6s var(--ease-out) forwards; }
  .card.is-on .a { animation-delay: 0.7s; }
  @keyframes pop { to { opacity: 1; transform: none; } }

  /* ChatGPT app: question, MCP tool call, live results */
  .mcpv { display: grid; gap: 7px; width: 100%; max-width: 340px; }
  .mcpv .bubble { padding: 9px 14px; font-size: 0.8125rem; }
  .call { justify-self: start; padding: 6px 12px; border-radius: 10px; background: #1d1d1f; color: #e8e8ed; font: 0.6875rem/1.5 ui-monospace, SFMono-Regular, Menlo, monospace; opacity: 0; transform: translateY(10px); }
  .call .fn { color: color-mix(in srgb, var(--a3) 70%, white); }
  .call .val { color: color-mix(in srgb, var(--a2) 60%, white); }
  .app { display: grid; gap: 5px; padding: 6px; border-radius: 14px; background: var(--white); box-shadow: 0 10px 30px -14px rgb(0 0 0 / 0.25), inset 0 0 0 1px var(--gray-2); }
  .app li { display: grid; grid-template-columns: 22px 1fr auto; align-items: center; gap: 9px; padding: 5px 8px; border-radius: 10px; background: var(--gray); font-size: 0.75rem; opacity: 0; transform: translateY(10px); }
  .app i { width: 22px; height: 18px; border-radius: 6px; background: linear-gradient(135deg, var(--a1), var(--a3)); opacity: 0.7; }
  .app b { font-weight: 650; white-space: nowrap; }
  .card.is-on .mcpv .call { animation: pop 0.5s var(--ease-out) 0.6s forwards; }
  .card.is-on .app li { animation: pop 0.45s var(--ease-out) forwards; animation-delay: calc(1.1s + var(--k) * 0.25s); }

  /* 2: pages getting indexed */
  .pages { display: grid; grid-template-columns: repeat(12, 1fr); gap: 4px; width: 100%; max-width: 330px; }
  .pages i { aspect-ratio: 1; border-radius: 3px; background: var(--gray-2); }
  .card.is-on .pages i { animation: fill 0.4s forwards; animation-delay: calc(var(--k) * 18ms); }
  .card.is-on .pages i.off { animation-name: fill-off; }
  @keyframes fill { to { background: #30d158; } }
  @keyframes fill-off { to { background: #ff453a; } }
  .legend { grid-column: 1 / -1; display: flex; align-items: center; gap: 6px; margin-top: 10px; font-size: 0.75rem; color: var(--muted); }
  .legend b { width: 9px; height: 9px; border-radius: 2px; background: #30d158; }
  .legend b.o { margin-left: 10px; background: #ff453a; }

  /* 3: hreflang code */
  .code { width: 100%; max-width: 360px; padding: 16px; border-radius: 14px; background: #1d1d1f; font: 500 0.75rem/1.9 ui-monospace, 'SF Mono', Menlo, monospace; color: #e8e8ed; letter-spacing: 0; }
  .code li { white-space: nowrap; opacity: 0; transform: translateX(-10px); }
  .tag { color: #ff7ab2; } .attr { color: #d9c97c; } .val { color: #fc6a5d; } .ok { color: #30d158; }
  .card.is-on .code li { animation: pop 0.5s var(--ease-out) forwards; animation-delay: calc(0.2s + var(--k) * 0.18s); }

  /* 4: redirects */
  .redir { display: grid; gap: 10px; width: 100%; max-width: 360px; }
  .redir li { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 8px; padding: 10px 12px; border-radius: 12px; background: var(--gray); font: 500 0.6875rem/1.3 ui-monospace, 'SF Mono', Menlo, monospace; letter-spacing: 0; opacity: 0; transform: translateY(12px); }
  .old { color: var(--muted); text-decoration: line-through; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .new { color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: right; }
  .badge { padding: 2px 7px; border-radius: 999px; background: #0071e3; color: #fff; font-weight: 700; }
  .card.is-on .redir li { animation: pop 0.55s var(--ease-out) forwards; animation-delay: calc(0.2s + var(--k) * 0.22s); }

  /* 5: e-commerce facets */
  .shop { width: 100%; max-width: 340px; display: grid; gap: 12px; }
  .facets { display: flex; gap: 6px; flex-wrap: wrap; }
  .facets span { padding: 5px 11px; border-radius: 999px; background: var(--gray); font-size: 0.75rem; }
  .facets .on { background: var(--ink); color: #fff; }
  .facets .x { font-family: ui-monospace, 'SF Mono', Menlo, monospace; color: #ff453a; text-decoration: line-through; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .grid i { aspect-ratio: 4 / 5; border-radius: 12px; background: linear-gradient(160deg, var(--gray), var(--gray-2)); opacity: 0; transform: scale(0.9); }
  .card.is-on .grid i { animation: pop 0.5s var(--ease-out) forwards; animation-delay: calc(0.15s + var(--k) * 0.1s); }

  /* schema: a rich result and the JSON-LD types behind it */
  .rich { width: 100%; max-width: 360px; display: grid; gap: 3px; padding: 14px 16px; border-radius: 16px; background: var(--gray); }
  .r-url { font-size: 0.6875rem; color: var(--muted); }
  .r-title { font-size: 0.9375rem; font-weight: 600; color: #1a0dab; letter-spacing: -0.01em; }
  .r-meta { font-size: 0.75rem; color: var(--muted); opacity: 0; transform: translateY(6px); }
  .r-meta b { color: var(--ink); }
  .stars { color: #f5a623; letter-spacing: 1px; }
  .instock { color: #1e8e3e; }
  .r-ld { margin-top: 8px; padding: 10px 14px; border-radius: 12px; background: #1d1d1f; font: 500 0.6875rem/1.85 ui-monospace, 'SF Mono', Menlo, monospace; color: #e8e8ed; letter-spacing: 0; }
  .r-ld li { opacity: 0; transform: translateX(-8px); }
  .card.is-on .r-ld li { animation: pop 0.45s var(--ease-out) forwards; animation-delay: calc(0.2s + var(--k) * 0.18s); }
  .card.is-on .r-meta { animation: pop 0.6s var(--ease-out) 1s forwards; }

  /* webops: a release pipeline that stops a noindex before production */
  .pipe { width: 100%; max-width: 340px; display: grid; gap: 6px; }
  .pipe li { display: grid; grid-template-columns: 9px 1fr auto; align-items: center; gap: 10px; padding: 8px 12px; border-radius: 11px; background: var(--gray); font-size: 0.75rem; opacity: 0; transform: translateY(10px); }
  .pipe i { width: 9px; height: 9px; border-radius: 50%; background: var(--gray-2); }
  .pipe .s-ok i { background: #30d158; }
  .pipe .s-ok b { color: #1e8e3e; }
  .pipe .s-stop { background: #fff1f0; box-shadow: inset 0 0 0 1px rgb(255 69 58 / 0.35); }
  .pipe .s-stop i { background: #ff453a; }
  .pipe .s-stop b { font-size: 0.6875rem; font-weight: 700; color: #fff; background: #ff453a; padding: 2px 8px; border-radius: 999px; }
  .pipe .s-wait { color: var(--muted); }
  .card.is-on .pipe li { animation: pop 0.45s var(--ease-out) forwards; animation-delay: calc(0.2s + var(--k) * 0.32s); }

  /* content: a topic cluster around a hub page */
  .cluster { position: relative; width: 100%; max-width: 360px; height: 160px; }
  .cluster svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .cluster line { stroke: var(--gray-2); stroke-width: 0.6; vector-effect: non-scaling-stroke; }
  .card.is-on .cluster line { stroke: #0071e3; stroke-dasharray: 80; stroke-dashoffset: 80; animation: draw 0.6s var(--ease-out) forwards; animation-delay: calc(0.3s + var(--k) * 0.15s); }
  .hub, .tp { position: absolute; translate: -50% -50%; white-space: nowrap; border-radius: 999px; }
  .hub { left: 50%; top: 50%; padding: 9px 16px; background: var(--ai); color: #fff; font-size: 0.875rem; font-weight: 650; box-shadow: 0 10px 30px -10px color-mix(in srgb, var(--a2) 60%, transparent); }
  .tp { padding: 6px 11px; background: var(--white); box-shadow: inset 0 0 0 1px var(--line); font-size: 0.75rem; opacity: 0; scale: 0.8; }
  .card.is-on .tp { animation: tp 0.5s var(--ease-out) forwards; animation-delay: calc(0.5s + var(--k) * 0.15s); }
  @keyframes tp { to { opacity: 1; scale: 1; } }

  /* Mobile: native swipe carousel instead of the pinned scene */
  @media (max-height: 820px) and (min-width: 900px) {
    .svc .lead { display: none; }
    .vis { padding-top: 18px; }
  }
  @media (max-width: 899px) {
    .svc { padding-block: clamp(80px, 12vw, 120px); }
    .svc .head { margin-bottom: 32px; }
    .hs { height: auto !important; }
    .hs__sticky { position: static; height: auto; }
    .track { overflow-x: auto; scroll-snap-type: x mandatory; transform: none; padding-bottom: 8px; scrollbar-width: none; }
    .track::-webkit-scrollbar { display: none; }
    .card { scroll-snap-align: center; height: 560px; }
    .bar { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .bubble, .code li, .redir li, .grid i, .r-meta, .r-ld li, .pipe li, .call, .app li { opacity: 1; transform: none; }
    .tp { opacity: 1; scale: 1; }
  }
</style>
