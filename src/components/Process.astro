---
import { getDict, type Lang } from '../i18n';
interface Props { lang: Lang }
const t = getDict(Astro.props.lang);
const p = t.process;
const icons = [
  '<circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21"/>',
  '<path d="M4 6h16M4 12h10M4 18h6"/>',
  '<path d="m8 9-4 3 4 3M16 9l4 3-4 3M13.5 6l-3 12"/>',
  '<path d="M4 20V4M4 20h16"/><path d="m7 15 4-4 3 3 5-6"/>',
];
---

<section class="section section--gray" id="proces" aria-labelledby="proces-h">
  <div class="wrap">
    <header class="head">
      <p class="eyebrow" data-reveal>{p.label}</p>
      <h2 class="h2" id="proces-h" data-reveal>{p.title}</h2>
    </header>
  </div>
  <div class="wrap wrap--wide">
    <ol class="steps">
      {p.steps.map((s, i) => (
        <li class="step" data-reveal style={`--d:${i}`}>
          <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[i]} />
          <h3>{s.name}</h3>
          <p>{s.desc}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }
  .step {
    padding: clamp(28px, 3vw, 40px);
    border-radius: var(--r-lg);
    background: var(--white);
  }
  .ic {
    width: 40px;
    height: 40px;
    color: var(--blue);
    margin-bottom: 28px;
  }
  h3 {
    font-size: 1.5rem;
    font-weight: 650;
    letter-spacing: -0.03em;
  }
  p {
    margin-top: 10px;
    color: var(--muted);
  }
  @media (max-width: 980px) {
    .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .steps { grid-template-columns: 1fr; }
  }
</style>
