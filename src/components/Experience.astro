---
import { getDict, type Lang } from '../i18n';
interface Props { lang: Lang }
const t = getDict(Astro.props.lang);
const e = t.experience;
---

<section class="section" id="doswiadczenie" aria-labelledby="exp-h">
  <div class="wrap">
    <header class="head">
      <p class="eyebrow" data-reveal>{e.label}</p>
      <h2 class="h2" id="exp-h" data-reveal>{e.title}</h2>
      <p class="lead" data-reveal style="--d:1">{e.intro}</p>
    </header>

    <ol class="list">
      {e.items.map((it) => (
        <li class:list={['job', { hl: 'highlight' in it && it.highlight }]} data-reveal>
          <p class="when">{it.when}</p>
          <div>
            <h3 class="org">{it.org}</h3>
            <p class="role">{it.role}</p>
            <p class="desc">{it.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .list {
    border-top: 1px solid var(--line);
  }
  .job {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 8px 40px;
    padding: 32px 0;
    border-bottom: 1px solid var(--line);
  }
  .when {
    color: var(--muted);
    font-size: 1.0625rem;
    padding-top: 4px;
    font-variant-numeric: tabular-nums;
  }
  .org {
    font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.75rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .role {
    margin-top: 4px;
    font-size: 1.0625rem;
    font-weight: 500;
  }
  .desc {
    margin-top: 10px;
    color: var(--muted);
    max-width: 62ch;
  }
  .hl .org {
    background: var(--ai);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    display: inline-block;
  }
  .hl .desc {
    color: var(--ink);
  }
  @media (max-width: 720px) {
    .job { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
