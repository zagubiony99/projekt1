---
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import Statement from './Statement.astro';
import Stage from './Stage.astro';
import Stats from './Stats.astro';
import Services from './Services.astro';
import Experience from './Experience.astro';
import Process from './Process.astro';
import Faq from './Faq.astro';
import Contact from './Contact.astro';
import CtaBand from './CtaBand.astro';
import Compare from './Compare.astro';
import StickyCta from './StickyCta.astro';
import { getDict } from '../i18n';
import Footer from './Footer.astro';
import type { Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang);
const toContact = `#${t.ids.contact}`;
---

<Base lang={lang}>
  <Nav lang={lang} />
  <main id="main">
    <Hero lang={lang} />
    <Statement lang={lang} />
    <Stage lang={lang} />
    <Stats lang={lang} />
    <Services lang={lang} />
    <CtaBand {...t.bands.afterServices} href={toContact} />
    <Compare lang={lang} />
    <Experience lang={lang} />
    <Process lang={lang} />
    <CtaBand {...t.bands.afterProcess} href={toContact} />
    <Faq lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
  <StickyCta lang={lang} />
</Base>

<script>
  import '../scripts/main.ts';
</script>
