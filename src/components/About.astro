---
import { site } from '../config';
import { getDict, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang);
const a = t.about;
---

<section class="section about" id="o-mnie" aria-labelledby="o-mnie-h">
  <div class="wrap grid">
    <figure class="pic" data-reveal>
      {site.photo ? (
        <img src={site.photo} alt={site.name} width="800" height="1000" loading="lazy" decoding="async" />
      ) : (
        <div class="initials" aria-hidden="true">
          <span>MZ</span>
        </div>
      )}
      <span class="hi" aria-hidden="true">{lang === 'pl' ? 'Cześć!' : 'Hi!'}</span>
    </figure>

    <div class="copy">
      <p class="pill" data-reveal>{a.label}</p>
      <h2 class="h2" id="o-mnie-h" data-reveal>{a.title}</h2>
      {a.paragraphs.map((p, i) => <p class="p" data-reveal style={`--d:${i + 1}`}>{p}</p>)}
      <dl class="facts" data-reveal style="--d:2">
        {a.facts.map((f) => (
          <div>
            <dt>{f.k}</dt>
            <dd>{f.v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--cream-2);
  }
  .grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }
  .pic {
    position: sticky;
    top: 110px;
  }
  .pic img,
  .initials {
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: var(--r-lg);
    object-fit: cover;
  }
  .initials {
    display: grid;
    place-items: center;
    background: var(--forest);
    color: var(--lime);
    overflow: hidden;
    container-type: inline-size;
  }
  .initials span {
    font-size: 52cqw;
    font-weight: 800;
    letter-spacing: -0.07em;
    line-height: 1;
    transform: rotate(-6deg);
  }
  .hi {
    position: absolute;
    right: -14px;
    bottom: 36px;
    padding: 14px 22px;
    border-radius: 999px;
    background: var(--coral);
    font-size: clamp(1.25rem, 1rem + 0.8vw, 1.75rem);
    font-weight: 780;
    letter-spacing: -0.03em;
    transform: rotate(-8deg);
    box-shadow: 0 12px 30px -12px rgb(10 31 25 / 0.5);
  }
  .copy {
    display: grid;
    gap: 24px;
    justify-items: start;
  }
  .copy .h2 {
    margin-bottom: 8px;
  }
  .p {
    font-size: var(--fs-lead);
    line-height: 1.45;
    max-width: 38ch;
    color: var(--ink-soft);
  }
  .p:first-of-type {
    color: var(--forest);
  }
  .facts {
    margin-top: 16px;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .facts div {
    padding: 20px 22px;
    border-radius: var(--r);
    background: var(--cream);
  }
  .facts dt {
    font-size: 0.875rem;
    font-weight: 550;
    opacity: 0.65;
  }
  .facts dd {
    margin-top: 4px;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
    .pic { position: relative; top: 0; max-width: 420px; }
    .hi { right: 12px; }
  }
  @media (max-width: 520px) {
    .facts { grid-template-columns: 1fr; }
  }
</style>
