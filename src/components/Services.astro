---
import { getDict, type Lang } from '../i18n';
interface Props { lang: Lang }
const t = getDict(Astro.props.lang);
const s = t.services;
---

<section class="section" id="uslugi" aria-labelledby="uslugi-h">
  <div class="wrap">
    <header class="center-head">
      <p class="eyebrow" data-reveal>{s.label}</p>
      <h2 class="h2" id="uslugi-h" data-reveal>{s.title}</h2>
      <p class="lead" data-reveal style="--d:1">{s.intro}</p>
    </header>

    <ul class="tiles">
      {s.items.map((it, i) => (
        <li class:list={['tile', { feature: i === 1 }]} data-reveal style={`--d:${i % 2}`}>
          <h3>{it.name}</h3>
          <p>{it.desc}</p>
          <ul class="tags">
            {it.tags.map((tg) => <li>{tg}</li>)}
          </ul>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .tile {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 340px;
    padding: clamp(28px, 3.4vw, 48px);
    border-radius: var(--r-lg);
    background: var(--gray);
    transition: transform 0.5s var(--ease-out);
  }
  .tile:hover {
    transform: scale(1.012);
  }
  h3 {
    font-size: clamp(1.75rem, 1.3rem + 1.4vw, 2.5rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
    font-weight: 750;
    color: var(--forest);
    text-wrap: balance;
  }
  .tile > p {
    color: var(--ink-2);
    font-size: 1.0625rem;
    line-height: 1.5;
    max-width: 46ch;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
    padding-top: 12px;
  }
  .tags li {
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--white);
    font-size: 0.8125rem;
    font-weight: 550;
    color: var(--ink-2);
  }
  .feature {
    background: var(--forest);
  }
  .feature h3 {
    color: var(--green);
  }
  .feature > p {
    color: rgb(255 255 255 / 0.82);
  }
  .feature .tags li {
    background: rgb(159 232 112 / 0.16);
    color: var(--green);
  }
  @media (max-width: 760px) {
    .tiles { grid-template-columns: 1fr; }
    .tile { min-height: 0; }
  }
</style>
