---
import { getDict, type Lang } from '../i18n';
import AiDemo from './AiDemo.astro';
interface Props { lang: Lang }
const t = getDict(Astro.props.lang);
const h = t.hero;
// Split headline into words so each can rise out of a blur, one after another.
let n = 0;
// split on ordinary spaces only, so non-breaking pairs like "w Google." stay together
const words = (s: string) => s.split(/[ \t\n]+/).filter(Boolean).map((w) => ({ w, i: n++ }));
const a = words(h.titleA);
const b = words(h.titleB);
---

<section class="hero" id="top" data-hero>
  <div class="glow" aria-hidden="true"></div>
  <div class="wrap top" data-hero-inner>
    <p class="eyebrow intro" style="--i:0">{h.pill}</p>
    <h1>
      <span class="line">{a.map((x) => <span class="w" style={`--i:${x.i + 1}`}>{x.w}</span>)}</span>
      <span class="line ai-line">{b.map((x) => <span class="w ai" style={`--i:${x.i + 1}`}>{x.w}</span>)}</span>
    </h1>
    <p class="lead intro" style={`--i:${n + 2}`}>{h.lead}</p>
    <div class="ctas intro" style={`--i:${n + 3}`}>
      <a class="btn" href={`#${t.ids.contact}`} data-magnet>{h.ctaPrimary}</a>
      <a class="more" href={`#${t.ids.experience}`}>{h.ctaSecondary}</a>
    </div>
    <p class="note intro" style={`--i:${n + 4}`}>{h.ctaNote}</p>
    <div class="trust intro" style={`--i:${n + 5}`}>
      <span>{h.trustLabel}</span>
      <b>Philip Morris International</b><b>Accenture Song</b><b>IG</b>
    </div>
  </div>
  <div class="wrap">
    <AiDemo lang={Astro.props.lang} />
  </div>
</section>

<style>
  .hero {
    --h: 0;
    position: relative;
    padding-top: clamp(104px, 13vh, 150px);
    padding-bottom: clamp(56px, 9vh, 112px);
    overflow: hidden;
  }
  /* Soft accent aura behind the headline, breathing slowly */
  .glow {
    position: absolute;
    left: 50%;
    top: 46%;
    width: min(1100px, 120vw);
    aspect-ratio: 2 / 1;
    translate: -50% -50%;
    background:
      radial-gradient(35% 50% at 30% 50%, color-mix(in srgb, var(--a1) 16%, transparent), transparent 70%),
      radial-gradient(35% 50% at 55% 55%, color-mix(in srgb, var(--a2) 14%, transparent), transparent 70%),
      radial-gradient(30% 45% at 75% 45%, color-mix(in srgb, var(--a4) 12%, transparent), transparent 70%);
    opacity: calc(1 - var(--h) * 1.4);
    animation: breathe 9s ease-in-out infinite;
    will-change: transform;
    pointer-events: none;
  }
  @keyframes breathe {
    50% { transform: scale(1.12) rotate(4deg); }
  }
  .top {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 22px;
    /* scroll-out: recede and fade like an apple.com product hero */
    transform: translateY(calc(var(--h) * -60px)) scale(calc(1 - var(--h) * 0.08));
    opacity: calc(1 - var(--h) * 1.3);
    will-change: transform, opacity;
  }
  h1 {
    display: grid;
    font-size: clamp(3rem, 1.2rem + 6.6vw, 6.75rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
    font-weight: 700;
  }
  .line {
    display: block;
  }
  .w {
    display: inline-block;
    margin-right: 0.22em;
  }
  .w:last-child {
    margin-right: 0;
  }
  .ai-line .w {
    padding-bottom: 0.08em;
    background-size: 300% 100%;
    animation: shimmer 8s ease-in-out infinite;
  }
  @keyframes shimmer {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }
  .top .lead {
    max-width: 38ch;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 16px 32px;
    margin-top: 14px;
  }
  .note {
    margin-top: -6px;
    color: var(--muted);
    font-size: 0.875rem;
  }
  .trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 6px 22px;
    margin-top: 18px;
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .trust b {
    color: #515154;
    font-size: 1.0625rem;
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  /* Entrance: each word rises out of a blur, staggered */
  :global(.js) .w,
  :global(.js) .intro {
    opacity: 0;
    filter: blur(14px);
    transform: translateY(0.35em);
    animation: rise 1.3s var(--ease-out) forwards;
    animation-delay: calc(0.15s + var(--i) * 0.09s);
  }
  :global(.js) .ai-line .w {
    animation: rise 1.3s var(--ease-out) calc(0.15s + var(--i) * 0.09s) forwards, shimmer 8s ease-in-out 2s infinite;
  }
  @keyframes rise {
    to { opacity: 1; filter: blur(0); transform: none; }
  }
  @media (max-width: 520px) {
    .ctas .btn { width: 100%; }
  }
</style>
