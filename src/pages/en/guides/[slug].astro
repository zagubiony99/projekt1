---
import GuidePage from '../../../components/GuidePage.astro';
import { guides } from '../../../data/pages';
export function getStaticPaths() {
  return guides.map((g) => ({ params: { slug: g.en.slug }, props: { key: g.key } }));
}
const { key } = Astro.props;
---

<GuidePage lang="en" key={key} />
