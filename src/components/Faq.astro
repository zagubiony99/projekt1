---
import { getDict, type Lang } from '../i18n';
interface Props { lang: Lang }
const t = getDict(Astro.props.lang);
const f = t.faq;
---

<section class="section section--gray" id="faq" aria-labelledby="faq-h">
  <div class="wrap">
    <header class="center-head">
      <p class="eyebrow" data-reveal>{f.label}</p>
      <h2 class="h2" id="faq-h" data-reveal>{f.title}</h2>
    </header>
    <div class="items">
      {f.items.map((it, i) => (
        <details class="q" name="faq" open={i === 0}>
          <summary>
            <span>{it.q}</span>
            <span class="pm" aria-hidden="true"></span>
          </summary>
          <p class="a">{it.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .items {
    max-width: 860px;
    margin-inline: auto;
    display: grid;
    gap: 12px;
  }
  .q {
    border-radius: var(--r);
    background: var(--white);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 24px 28px;
    cursor: pointer;
    list-style: none;
    font-size: 1.1875rem;
    font-weight: 650;
    letter-spacing: -0.025em;
  }
  summary::-webkit-details-marker { display: none; }
  .pm {
    position: relative;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--gray);
    transition: transform 0.35s var(--ease-out), background-color 0.2s;
  }
  .pm::before,
  .pm::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 2px;
    border-radius: 2px;
    background: var(--forest);
    translate: -50% -50%;
  }
  .pm::after { rotate: 90deg; }
  .q[open] .pm {
    transform: rotate(45deg);
    background: var(--green);
  }
  .a {
    padding: 0 28px 26px;
    max-width: 66ch;
    color: var(--ink-2);
    font-size: 1.0625rem;
  }
</style>
