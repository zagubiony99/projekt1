---
interface Props { title: string; text: string; btn: string; href: string; dark?: boolean }
const { title, text, btn, href, dark = false } = Astro.props;
---

<section class:list={['band', { 'section--black': dark }]} data-dark={dark ? '' : undefined}>
  <div class="wrap inner" data-reveal>
    <div>
      <p class="t">{title}</p>
      <p class="d">{text}</p>
    </div>
    <a class="btn" href={href} data-magnet>{btn}</a>
  </div>
</section>

<style>
  .band {
    padding-block: clamp(48px, 7vw, 88px);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 48px;
    padding-block: clamp(28px, 4vw, 44px);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .section--black .inner {
    border-color: var(--dark-line);
  }
  .t {
    font-size: clamp(1.625rem, 1.2rem + 1.6vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }
  .d {
    margin-top: 8px;
    max-width: 52ch;
    color: var(--muted);
    font-size: 1.0625rem;
  }
  .section--black .d {
    color: var(--dark-muted);
  }
  @media (max-width: 640px) {
    .btn { width: 100%; }
  }
</style>
