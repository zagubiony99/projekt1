---
import { getDict, type Lang } from '../i18n';
interface Props { lang: Lang }
const t = getDict(Astro.props.lang);
const f = t.faq;
---

<section class="section" id="faq" aria-labelledby="faq-h">
  <div class="wrap">
    <header class="head">
      <p class="eyebrow" data-reveal>{f.label}</p>
      <h2 class="h2" id="faq-h" data-reveal>{f.title}</h2>
    </header>
    <div class="items">
      {f.items.map((it, i) => (
        <details class="q" name="faq" open={i === 0}>
          <summary>
            <span>{it.q}</span>
            <span class="pm" aria-hidden="true"></span>
          </summary>
          <p class="a">{it.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .items {
    max-width: 820px;
    margin-inline: auto;
    border-top: 1px solid var(--line);
  }
  .q {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 26px 0;
    cursor: pointer;
    list-style: none;
    font-size: clamp(1.1875rem, 1.1rem + 0.3vw, 1.375rem);
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  summary::-webkit-details-marker { display: none; }
  .pm {
    position: relative;
    flex: none;
    width: 22px;
    height: 22px;
    transition: transform 0.4s var(--ease-out);
  }
  .pm::before,
  .pm::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 16px;
    height: 1.75px;
    border-radius: 2px;
    background: var(--ink);
    translate: -50% -50%;
  }
  .pm::after { rotate: 90deg; }
  .q[open] .pm { transform: rotate(45deg); }
  .a {
    padding-bottom: 28px;
    max-width: 66ch;
    color: var(--muted);
    font-size: 1.0625rem;
  }
  .q[open] .a { animation: open 0.5s var(--ease-out); }
  @keyframes open {
    from { opacity: 0; transform: translateY(-6px); }
  }
</style>
